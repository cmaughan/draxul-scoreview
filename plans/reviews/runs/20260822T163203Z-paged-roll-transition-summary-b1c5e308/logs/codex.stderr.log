   88:         return windowed_;
   89:     }
   90:     void set_windowed(bool windowed)
   91:     {
   92:         windowed_ = windowed;
   93:     }
   94:     // Whether the main engine currently holds a window document.
   95:     bool active() const
   96:     {
   97:         return active_;
   98:     }
   99:     void set_active(bool active)
  100:     {
  101:         active_ = active;
  102:     }
  103:     // Startup performs one synchronous build before interactive frames
  104:     // exist; every later rebuild goes through the latest-wins worker.
  105:     bool initial_window_installed() const
  106:     {
  107:         return initial_window_installed_;
  108:     }
  109:     void set_initial_window_installed(bool installed)
  110:     {
  111:         initial_window_installed_ = installed;
  112:     }
  113: 
  114:     // --- composer / program / archive ------------------------------------
  115:     IComposer& composer()
  116:     {
  117:         return *composer_;
  118:     }
  119:     // Selects the stream composer by name (kanban 22 seam): a config key /
  120:     // launch token drives which IComposer runs; the constructor seeds the
  121:     // adaptive-stream default. Returns false for an unknown name, leaving the
  122:     // current composer in place. A no-op (returns true) when `name` already
  123:     // names the active composer, so re-selecting on every reload is free.
  124:     bool select_composer(std::string_view name);
  125:     StreamProgram& program()
  126:     {
  127:         return program_;
  128:     }
  129:     const StreamProgram& program() const
  130:     {
  131:         return program_;
  132:     }
  133:     VerdictArchive& verdict_archive()
  134:     {
  135:         return verdict_archive_;
  136:     }
  137:     bool composing() const
  138:     {
  139:         return composing_;
  140:     }
  141:     void set_composing(bool composing)
  142:     {
  143:         composing_ = composing;
  144:     }
  145:     // Drops the planned program AND the composer's slot-indexed policy state
  146:     // together (they must never diverge), plus the plan-log cursor.
  147:     void reset_plan();
  148: 
  149:     // --- window geometry --------------------------------------------------
  150:     // The urgent rewrite (plans/scoreview-composer.md, rewriting composer):
  151:     // splice the composer's correction in just past the playhead — one guard
  152:     // bar covers the async window swap, so nothing playable during the
  153:     // engrave has its provenance moved. Returns true when the program
  154:     // changed and the caller should re-engrave the current window.
  155:     bool try_urgent_rewrite(double stream_q);
  156:     int window_first_bar() const
  157:     {
  158:         return window_first_bar_;
  159:     }
  160:     int window_bar_count() const
  161:     {
  162:         return window_bar_count_;
  163:     }
  164:     double stream_offset_q() const
  165:     {
  166:         return stream_offset_q_;
  167:     }
  168:     // The install swap succeeded: adopt the new window's geometry.
  169:     void note_installed(int first_bar, int count, double stream_offset_q)
  170:     {
  171:         window_first_bar_ = first_bar;
  172:         window_bar_count_ = count;
  173:         stream_offset_q_ = stream_offset_q;
  174:         active_ = true;
  175:         initial_window_installed_ = true;
  176:     }
  177:     // Leaving the window for the monolithic strip: the stream axis becomes
  178:     // the local axis again.
  179:     void clear_window_geometry()
  180:     {
  181:         window_first_bar_ = 0;
  182:         window_bar_count_ = 0;
  183:         stream_offset_q_ = 0.0;
  184:     }
  185:     // Stream-axis end of a window (slot axis when composing, source bars
  186:     // otherwise) — the verdict archive's replay bound.
  187:     double window_end_q(int first_bar, int count) const;
  188: 
  189:     // --- planning ----------------------------------------------------------
  190:     // `first_bar` indexes STREAM SLOTS when the composer drives the program
  191:     // (S3); with the composer inactive it is a plain source-bar index.
  192:     std::optional<WindowSlice> build_window_slice(int first_bar);
  193:     // The advance policy: the next window's first bar when the playhead has
  194:     // come within `ahead_needed` of the window's tail; nullopt otherwise
  195:     // (including when the program/source is exhausted).
  196:     std::optional<int> advance_target(double stream_q, int ahead_needed) const;
  197: 
  198:     // --- the async-engrave worker state machine ---------------------------
  199:     void adopt_engraver(std::unique_ptr<WindowEngraver> engraver)
  200:     {
  201:         engraver_ = std::move(engraver);
  202:     }
  203:     bool engraver_available() const
  204:     {
  205:         return engraver_ != nullptr;
  206:     }
  207:     bool engrave_busy() const
  208:     {
  209:         return engraver_ && engraver_->busy();
  210:     }
  211:     bool async_in_flight() const
  212:     {
  213:         return async_in_flight_;
  214:     }
  215:     WindowEngraver::RequestId pending_request() const
  216:     {
  217:         return pending_install_ ? pending_install_->request_id : 0;
  218:     }
  219:     // Submits the slice as the newest generation (latest wins). False when
  220:     // the worker rejects the job.
  221:     bool queue_engrave(
  222:         WindowSlice&& slice, const EngraveParams& params, PendingInstall intent);
  223:     // Cancels the worker and drops any pending install.
  224:     void cancel_async();
  225:     // Destroys the worker (its destructor joins the thread) and drops any
  226:     // pending install — the shutdown path.
  227:     void reset_engraver()
  228:     {
  229:         engraver_.reset();
  230:         pending_install_.reset();
  231:         async_in_flight_ = false;
  232:     }
  233:     // Polls the worker; a completion is generation-checked here — stale
  234:     // generations are dropped (logged) and never reach the host.
  235:     std::optional<Completed> poll_completed();
  236:     // The generation filter alone, for completions delivered out-of-band
  237:     // (the deterministic test seam).
  238:     std::optional<Completed> filter_completion(WindowEngraver::Done done);
  239: 
  240: private:
  241:     SourceSlicer slicer_;
  242:     bool windowed_ = true;
  243:     bool active_ = false;
  244:     bool initial_window_installed_ = false;
  245: 
  246:     std::unique_ptr<IComposer> composer_;
  247:     StreamProgram program_;
  248:     VerdictArchive verdict_archive_;
  249:     bool composing_ = false;
  250:     int last_logged_plan_slot_ = -1;
  251: 
  252:     int window_first_bar_ = 0;
  253:     int window_bar_count_ = 0;
  254:     double stream_offset_q_ = 0.0;
  255: 
  256:     std::unique_ptr<WindowEngraver> engraver_;
  257:     bool async_in_flight_ = false;
  258:     std::optional<PendingInstall> pending_install_;
  259: };
