  106: bool SourceSlicer::load(const std::string& musicxml, std::string& error)
  107: {
  108:     impl_ = std::make_unique<Impl>();
  109:     if (impl_->document.Parse(musicxml.c_str(), musicxml.size()) != XML_SUCCESS)
  110:     {
  111:         error = "source did not parse as XML";
  112:         return false;
  113:     }
  114:     const XMLElement* root = impl_->document.FirstChildElement("score-partwise");
  115:     if (root == nullptr)
  116:     {
  117:         error = "source is not a score-partwise MusicXML document";
  118:         return false;
  119:     }
  120: 
  121:     for (const XMLElement* child = root->FirstChildElement(); child != nullptr;
  122:         child = child->NextSiblingElement())
  123:     {
  124:         if (std::string(child->Name()) == "part")
  125:         {
  126:             Impl::Part part;
  127:             part.id = child->Attribute("id") != nullptr ? child->Attribute("id") : "";
  128:             AttributeState state;
  129:             for (const XMLElement* measure = child->FirstChildElement("measure");
  130:                 measure != nullptr; measure = measure->NextSiblingElement("measure"))
  131:             {
  132:                 part.state_before.push_back(state);
  133:                 part.measures.push_back(measure);
  134:                 // Accumulate the attribute state this measure declares.
  135:                 for (const XMLElement* attributes = measure->FirstChildElement("attributes");
  136:                     attributes != nullptr;
  137:                     attributes = attributes->NextSiblingElement("attributes"))
  138:                 {
  139:                     if (const XMLElement* divisions = attributes->FirstChildElement("divisions"))
  140:                         state.divisions = element_xml(divisions);
  141:                     if (const XMLElement* key = attributes->FirstChildElement("key"))
  142:                         state.key = element_xml(key);
  143:                     if (const XMLElement* time = attributes->FirstChildElement("time"))
  144:                         state.time = element_xml(time);
  145:                     if (const XMLElement* staves = attributes->FirstChildElement("staves"))
  146:                         state.staves = element_xml(staves);
  147:                     for (const XMLElement* clef = attributes->FirstChildElement("clef");
  148:                         clef != nullptr; clef = clef->NextSiblingElement("clef"))
  149:                     {
  150:                         const int number = clef->IntAttribute("number", 0);
  151:                         state.clefs[number] = element_xml(clef);
  152:                     }
  153:                 }
  154:             }
  155:             impl_->parts.push_back(std::move(part));
  156:         }
  157:         else
  158:         {
  159:             impl_->header_children.push_back(element_xml(child));
  160:         }
  161:     }
  162:     if (!ready())
  163:     {
  164:         error = "source holds no measures";
  165:         return false;
  166:     }
  167: 
  168:     // Bar starts on the quarter axis from the notated time signatures.
  169:     // (Implicit pickup bars would shift this — a recorded S2 limitation.)
  170:     double q = 0.0;
  171:     double bar_quarters = 4.0;
  172:     const Impl::Part& first_part = impl_->parts.front();
  173:     impl_->bar_start_q.push_back(0.0);
  174:     for (size_t bar = 0; bar < first_part.measures.size(); ++bar)
  175:     {
  176:         const AttributeState& state = bar < first_part.state_before.size()
  177:             ? first_part.state_before[bar]
  178:             : AttributeState{};
  179:         // The measure itself may declare a new time signature.
  180:         std::string time_xml = state.time;
  181:         for (const XMLElement* attributes = first_part.measures[bar]->FirstChildElement("attributes");
  182:             attributes != nullptr; attributes = attributes->NextSiblingElement("attributes"))
  183:         {
  184:             if (const XMLElement* time = attributes->FirstChildElement("time"))
  185:                 time_xml = element_xml(time);
  186:         }
  187:         if (!time_xml.empty())
  188:         {
  189:             XMLDocument time_doc;
  190:             if (time_doc.Parse(time_xml.c_str()) == XML_SUCCESS)
  191:             {
  192:                 const XMLElement* time = time_doc.FirstChildElement("time");
  193:                 const XMLElement* beats = time != nullptr ? time->FirstChildElement("beats") : nullptr;
  194:                 const XMLElement* beat_type = time != nullptr ? time->FirstChildElement("beat-type") : nullptr;
  195:                 if (beats != nullptr && beat_type != nullptr)
  196:                 {
  197:                     const double b = std::max(1.0, beats->DoubleText(4.0));
  198:                     const double bt = std::max(1.0, beat_type->DoubleText(4.0));
  199:                     bar_quarters = b * 4.0 / bt;
  200:                 }
  201:             }
  202:         }
  203:         q += bar_quarters;
  204:         impl_->bar_start_q.push_back(q);
  205:     }
  206:     return true;
  207: }
