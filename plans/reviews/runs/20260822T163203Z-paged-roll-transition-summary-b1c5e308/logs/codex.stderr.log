  225: int SourceSlicer::divisions_at(int bar) const
  226: {
  227:     if (!ready())
  228:         return 1;
  229:     const Impl::Part& part = impl_->parts.front();
  230:     const int last = static_cast<int>(part.state_before.size()) - 1;
  231:     // state_before[b] is the state BEFORE bar b; the state in force AT
  232:     // `bar` includes its own declarations, i.e. state_before[bar + 1].
  233:     for (int at = std::min(bar + 1, last); at >= 0; --at)
  234:     {
  235:         const std::string& xml = part.state_before[static_cast<size_t>(at)].divisions;
  236:         if (xml.empty())
  237:             continue;
  238:         XMLDocument doc;
  239:         if (doc.Parse(xml.c_str()) == XML_SUCCESS)
  240:         {
  241:             if (const XMLElement* divisions = doc.FirstChildElement("divisions"))
  242:                 return std::max(1, divisions->IntText(1));
  243:         }
  244:     }
  245:     return 1;
  246: }
