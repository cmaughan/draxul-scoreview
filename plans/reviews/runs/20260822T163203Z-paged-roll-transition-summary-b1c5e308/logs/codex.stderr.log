 1316: bool ScoreRuntime::handle_gate_key(int keycode)
 1317: {
 1318:     if (flow_.mode() == FlowController::TransportMode::Clock)
 1319:         return false;
 1320:     if (keycode == SDLK_ESCAPE)
 1321:     {
 1322:         exit_gate_mode();
 1323:         return true;
 1324:     }
 1325:     // `i` switches the human input source mid-session (mic <-> keyboard)
 1326:     // without touching verdicts, score, or the transport.
 1327:     const bool mic_live = input_rig_.kind() == PlayerInputRig::Kind::Mic;
 1328:     if (keycode == SDLK_I
 1329:         && (input_rig_.kind() == PlayerInputRig::Kind::Keyboard || mic_live))
 1330:     {
 1331:         const GateInput next = mic_live ? GateInput::Keyboard : GateInput::Mic;
 1332:         const bool engaged = set_gate_input(next, 0.0, 1.0);
 1333:         gate_input_requested_ = engaged ? next : GateInput::Keyboard;
 1334:         DRAXUL_LOG_INFO(LogCategory::App, "score: gate input -> %s",
 1335:             input_rig_.kind() == PlayerInputRig::Kind::Mic ? "microphone" : "keyboard");
 1336:         if (next == GateInput::Mic && engaged && !flow_.playing())
 1337:             flow_.play(); // the piano is the interface; don't demand Space
 1338:         return true;
 1339:     }
 1340:     if (input_rig_.kind() != PlayerInputRig::Kind::Keyboard)
 1900:         clear_piece_progress();
 1901:     if (callbacks_ != nullptr)
 1902:         callbacks_->request_frame();
 1903: }
