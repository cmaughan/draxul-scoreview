   77:     SourceSlicer& slicer()
   78:     {
   79:         return slicer_;
   80:     }
   81:     const SourceSlicer& slicer() const
   82:     {
   83:         return slicer_;
   84:     }
   85:     // The rolling window vs the monolithic strip (`mono`, failure fallback).
   86:     bool windowed() const
