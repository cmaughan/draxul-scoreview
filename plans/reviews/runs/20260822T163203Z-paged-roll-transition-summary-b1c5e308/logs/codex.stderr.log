 1905: void ScoreRuntime::on_key(const KeyEvent& event)
 1906: {
 1907:     if (imgui_.context() != nullptr)
 1908:     {
 1909:         const bool imgui_captured =
 1910:             plugin_support::ImGuiInputBridge::route_key(imgui_.context(), event);
 1911:         // The backtick always toggles the inspector, even with ImGui focused.
 1912:         if (event.pressed && event.keycode == SDLK_GRAVE)
 1913:         {
 1914:             show_debug_ui_ = !show_debug_ui_;
 1915:             if (callbacks_ != nullptr)
 1916:                 callbacks_->request_frame();
 1917:             return;
 1918:         }
 1919:         if (imgui_captured)
 1920:         {
 1921:             if (callbacks_ != nullptr)
 1922:                 callbacks_->request_frame();
 1923:             return;
 1924:         }
 1925:     }
 1926:     if (!event.pressed)
 1927:         return;
 1928:     if (event.keycode == SDLK_F)
 1929:     {
 1930:         toggle_flow_mode();
 1931:         return;
 1932:     }
 1933:     if (view_mode_ == ViewMode::Flow)
 1934:     {
 1935:         if (handle_gate_key(event.keycode))
 1936:         {
 1937:             if (callbacks_ != nullptr)
 1938:                 callbacks_->request_frame();
 1939:             return;
 1940:         }
 1941:         if (event.keycode == SDLK_G && flow_.mode() == FlowController::TransportMode::Clock && flow_.gates_ready())
 1942:         {
 1943:             game_mode_ = FlowController::TransportMode::Roll; // `g` = the game
 1944:             enter_gate_mode(GateInput::Keyboard, 0.0, 1.0);
 1945:             return;
 1946:         }
 1947:         switch (event.keycode)
 1948:         {
 1949:         case SDLK_SPACE:
 1950:             if (flow_.playing())
 1951:                 flow_.pause();
 1952:             else
 1953:                 flow_.play();
 1954:             break;
 1955:         case SDLK_LEFTBRACKET:
 1956:             flow_.set_tempo_qpm(flow_.tempo_qpm() / 1.04);
 1957:             break;
 1958:         case SDLK_RIGHTBRACKET:
 1959:             flow_.set_tempo_qpm(flow_.tempo_qpm() * 1.04);
 1960:             break;
 1961:         case SDLK_R:
 1962:             if (stream_active() && flow_.mode() == FlowController::TransportMode::Roll)
 1963:             {
 1964:                 restart_stream(/*keep_tempo=*/true);
 1965:             }
 1966:             else
 1967:             {
 1968:                 flow_.rewind();
 1969:                 apply_lit_update();
 1970:             }

