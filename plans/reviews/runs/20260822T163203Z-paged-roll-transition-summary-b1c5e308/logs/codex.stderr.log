   29: class ScoreStreamController
   30: {
   31: public:
   32:     // History bars kept behind the playhead. This must be enough to fill the
   33:     // scroll anchor (~30% of the viewport) so the playhead can sit at the
   34:     // anchor with music scrolling under it — too little and the scroll
   35:     // clamps to the strip's left edge, snapping the playhead back on every
   36:     // window advance.
   37:     static constexpr int kWindowHistoryBars = 4;
   38:     // Look-ahead bars in the window. Generous, because the window advances
   39:     // only when the playhead nears its tail (not every bar) — the extra
   40:     // ahead bars are the drift room between those (now rare) rebuilds.
   41:     static constexpr int kWindowAheadBars = 14;
   42: 
   43:     ScoreStreamController();
   44: 
   45:     // A window's MusicXML slice plus where it sits in the stream. Produced
   46:     // on the main thread (slicing + composer planning are cheap); the heavy
   47:     // Verovio engrave then runs sync (host engine) or on the worker.
   48:     struct WindowSlice
   49:     {
   50:         std::string xml;
   51:         int first_bar = 0;
   52:         int count = 0;
   53:         double stream_offset_q = 0.0;
   54:     };
   55: 
   56:     // What to do with a generation once the worker finishes it.
   57:     struct PendingInstall
   58:     {
   59:         WindowEngraver::RequestId request_id = 0;
   60:         double stream_position_q = 0.0;
   61:         bool carry = false;
   62:         bool preserve_tempo = false;
   63:         bool fallback_to_monolith_on_error = false;
   64:     };
   65: 
   66:     struct Completed
   67:     {
