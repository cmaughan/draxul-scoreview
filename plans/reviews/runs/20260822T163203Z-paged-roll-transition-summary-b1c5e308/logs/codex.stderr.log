  923: 
  924: void ScoreRuntime::apply_tempo_ladder()
  925: {
  926:     // The per-bar tempo ladder (C3): entering a bar caps the roll tempo at
  927:     // that bar's earned rung — clean passes raised it, fumbles lowered it.
  928:     // The cap only pulls DOWN; the ramp back up stays the roll easing's job,
  929:     // so tempo rises only through demonstrated accuracy. The tempo lock
  930:     // always wins, and drills inherit whatever tempo the stream is at.
    1: #include <draxul/scoreview/engraved_window.h>
    2: 
    3: #include <draxul/scoreview/keyboard_render_nvg.h>
    4: #include <draxul/scoreview/score_timemap.h>
    5: #include <draxul/scoreview/svg_score_interpreter.h>
    6: 
    7: #include <draxul/log.h>
    8: 
    9: #include <algorithm>
   10: #include <utility>
   11: 
   12: namespace draxul
   13: {
   14: namespace scoreview
   15: {
   16: 
   17: EngraveResult engrave_loaded(
   18:     ILayoutEngine& engine, const EngraveParams& params, EngravedWindow& out, std::string& error)
   19: {
   20:     LayoutOptions options;
   21:     options.mode = LayoutMode::Flow;
   22:     options.pixel_scale = params.pixel_scale;
   23:     options.proportional_spacing = params.proportional_spacing;
   24:     options.spacing_linear = params.spacing_linear;
   25:     options.spacing_non_linear = params.spacing_non_linear;
   26:     engine.set_options(options);
   27: 
   28:     auto strip = interpret_score_svg(engine.render_page_svg(1), error);
   29:     if (!strip)
   30:         return EngraveResult::InterpretFailed;
   31:     for (const std::string& warning : strip->warnings)
   32:         DRAXUL_LOG_DEBUG(LogCategory::App, "score flow interpreter: %s", warning.c_str());
   33: 
   34:     // Keep the strip even if the transport join fails: a failed window can
   35:     // still fall back to showing the engraving.
   36:     out.strip = std::make_shared<const ScoreDrawList>(std::move(*strip));
   37:     auto timemap = parse_timemap(engine.render_timemap(), error);
   38:     if (!timemap.has_value() || !out.flow.build(*timemap, *out.strip, error))
   39:         return EngraveResult::TransportFailed;
   40: 
   41:     // Expected notes + tie continuations for the gate (same id space).
   42:     out.flow.prepare_gates(
   43:         [&engine](const std::string& id) { return engine.midi_pitch_for_element(id); },
   44:         engine.tie_end_ids());
   45: 
   46:     // Whole-window coloring: resolve each note's spelling once (the engine
   47:     // knows its notated letter here) into the pairing palette.
   48:     out.palette.clear();
   49:     out.staves.clear();
   50:     for (const FlowController::Gate& gate : out.flow.gates())
   51:     {
   52:         for (const FlowController::GateNote& note : gate.notes)
   53:         {
   54:             if (note.pitch < 0)
   55:                 continue;
   56:             const int letter = engine.note_letter_for_element(note.id);
   57:             out.palette[note.id] = guidance_palette_index(note.pitch, letter);
   58:             const int staff = engine.staff_for_element(note.id);
   59:             if (staff > 0)
   60:                 out.staves[note.id] = staff;
   61:         }
   62:     }
   63: 
   64:     // Waterfall blocks: pair each timemap note_on with its note_off for a
   65:     // duration, colored by the same spelling palette as the sheet.
   66:     out.waterfall.clear();
   67:     const auto note_for = [&](const std::string& id, double onset, double off) {
   68:         const int midi = engine.midi_pitch_for_element(id);
   69:         WaterfallNote note;
   70:         note.onset_q = onset;
   71:         note.duration_q = std::max(0.05, off - onset);
   72:         note.midi = midi;
   73:         const auto pal = out.palette.find(id);
   74:         note.palette = pal != out.palette.end() ? pal->second : guidance_palette_index(midi);
   75:         return std::make_pair(note, midi >= 0);
   76:     };
   77:     std::unordered_map<std::string, double> open; // id -> onset q
   78:     for (const TimemapEntry& entry : timemap->entries)
   79:     {
   80:         for (const std::string& id : entry.note_off)
   81:         {
   82:             auto it = open.find(id);
   83:             if (it == open.end())
   84:                 continue;
   85:             auto [note, ok] = note_for(id, it->second, entry.qstamp);
   86:             if (ok)
   87:                 out.waterfall.push_back(note);
   88:             open.erase(it);
   89:         }
   90:         for (const std::string& id : entry.note_on)
   91:             open[id] = entry.qstamp;
   92:     }
   93:     // Notes without an explicit off (final ties) run to the piece end.
   94:     for (const auto& [id, onset] : open)
   95:     {
   96:         auto [note, ok] = note_for(id, onset, timemap->duration_q);
   97:         if (ok)
   98:             out.waterfall.push_back(note);
   99:     }
  100:     return EngraveResult::Ok;
  101: }
  102: 
  103: EngraveResult engrave_window(ILayoutEngine& engine, const std::string& window_xml,
  104:     const EngraveParams& params, EngravedWindow& out, std::string& error)
  105: {
  106:     if (window_xml.empty() || !engine.load(window_xml, error))
  107:         return EngraveResult::InterpretFailed;
  108: 
  109:     const EngraveResult result = engrave_loaded(engine, params, out, error);
  110:     if (result != EngraveResult::Ok)
  111:         return result;
  112: 
  113:     // Roll transport policy for a rolling window: the piece's marking (the
  114:     // slice lost the bar-1 tempo text), no adaptation while locked.
  115:     out.flow.set_marking_qpm(params.marking_qpm);
  116:     out.flow.set_mode(FlowController::TransportMode::Roll);
  117:     out.flow.set_adapt_tempo(!params.lock_tempo);
  118:     if (params.lock_tempo && params.marking_qpm > 0.0)
  119:         out.flow.set_tempo_qpm(params.marking_qpm);
  120:     return result;
  121: }
