   38: void ScoreSessionController::attach_source(
   39:     const std::filesystem::path& progress_dir, const std::string& source_bytes)
   40: {
   41:     progress_path_ = progress_path(progress_dir, source_bytes);
   42:     const std::string stored = load_progress(progress_path_);
   43:     if (!stored.empty() && model_.deserialize(stored))
   44:     {
   45:         DRAXUL_LOG_INFO(LogCategory::App,
   46:             "score: progress loaded — %zu session(s), %d notes, best tempo %d%%",
   47:             model_.sessions().size(), model_.total_notes_judged(),
   48:             static_cast<int>(std::lround(model_.best_tempo_frac() * 100.0)));
   49:     }
   50:     else if (!stored.empty())
   51:     {
   52:         DRAXUL_LOG_WARN(LogCategory::App, "score: progress file unreadable, starting fresh (%s)",
   53:             progress_path_.string().c_str());
   54:     }
   55: }
