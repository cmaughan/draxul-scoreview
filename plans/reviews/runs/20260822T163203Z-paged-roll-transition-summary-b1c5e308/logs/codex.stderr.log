 1056: void ScoreRuntime::poll_async_engrave()
 1057: {
 1058:     auto completed = stream_->poll_completed();
 1059:     if (!completed)
 1060:         return;
 1061:     apply_completed_engrave(std::move(completed->done), completed->intent.stream_position_q,
 1062:         completed->intent.carry, completed->intent.preserve_tempo,
 1063:         completed->intent.fallback_to_monolith_on_error);
 1064: }
 1065: 
 1066: void ScoreRuntime::handle_async_engrave_done(WindowEngraver::Done done)
 1067: {
 1068:     auto completed = stream_->filter_completion(std::move(done));
 1069:     if (!completed)
 1070:         return;
 1071:     apply_completed_engrave(std::move(completed->done), completed->intent.stream_position_q,
 1072:         completed->intent.carry, completed->intent.preserve_tempo,
 1073:         completed->intent.fallback_to_monolith_on_error);
 1074: }
 1075: 
 1076: void ScoreRuntime::apply_completed_engrave(WindowEngraver::Done done, double intent_position_q,
 1077:     bool carry, bool preserve_tempo, bool fallback_to_monolith)
 1078: {
 1079:     if (!done.ok)
 1080:     {
 1081:         // A failed speculative advance retains the old window until the
 1082:         // monolithic fallback can be rebuilt. Interactive restyling failures
 1083:         // simply keep the current valid engraving visible.
 1084:         if (fallback_to_monolith)
 1085:         {
 1086:             stream_->set_windowed(false);
 1087:             flow_dirty_ = true;
 1088:         }
 1089:         return;
 1090:     }
 1091:     // If the player left the rolling window while the engrave ran (paged view,
 1092:     // exited the game), drop the now-stale result rather than forcing Roll back.
 1093:     if (view_mode_ != ViewMode::Flow || flow_.mode() != FlowController::TransportMode::Roll)
 1094:         return;
 1095:     // Install at the CURRENT playhead (the old window kept advancing while the
 1096:     // engrave ran); carry replays the transport/verdicts onto the fresh strip.
 1097:     const int first_bar = done.first_bar;
 1098:     const int count = done.count;
 1099:     const auto install_start = std::chrono::steady_clock::now();
 1100:     const double install_position_q = carry ? stream_position_q() : intent_position_q;
 1101:     install_window(std::move(done.window), first_bar, count, done.stream_offset_q,
 1102:         install_position_q, carry, preserve_tempo);
 1103:     const double install_ms = std::chrono::duration<double, std::milli>(
 1104:         std::chrono::steady_clock::now() - install_start)
 1105:                                   .count();
 1106:     DRAXUL_LOG_DEBUG(LogCategory::App, "score: window -> bars %d..%d (%.1f ms install, async)",
 1107:         first_bar, first_bar + count - 1, install_ms);
 1108: }
