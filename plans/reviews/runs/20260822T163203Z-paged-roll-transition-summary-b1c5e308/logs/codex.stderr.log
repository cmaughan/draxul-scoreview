   15: // Name-keyed composer factory (kanban 22): the single place a second IComposer
   16: // registers. Unknown names return null so the caller keeps the current
   17: // composer; the controller seeds the adaptive-stream default at construction.
   18: std::unique_ptr<IComposer> make_composer(std::string_view name)
   19: {
   20:     if (name.empty() || name == "adaptive-stream")
   21:         return std::make_unique<StreamComposer>();
   22:     return nullptr;
   23: }
   24: } // namespace
   25: 
   26: ScoreStreamController::ScoreStreamController()
   27:     : composer_(make_composer("adaptive-stream"))
   28: {
   29: }
   30: 
   31: bool ScoreStreamController::select_composer(std::string_view name)
   32: {
   33:     if (composer_ && name == composer_->name())
   34:         return true; // already selected — keep its policy state
   35:     auto next = make_composer(name);
   36:     if (!next)
   37:         return false; // unknown name; the caller keeps the current composer
   38:     composer_ = std::move(next);
   39:     // A different composer plans a different program; drop the stale plan and
   40:     // the plan-log cursor so the new one starts clean (mirrors reset_plan).
   41:     program_.clear();
   42:     last_logged_plan_slot_ = -1;
   43:     return true;
   44: }
   45: 
   46: void ScoreStreamController::reset_plan()
   47: {
   48:     program_.clear();
   49:     composer_->reset();
   50:     last_logged_plan_slot_ = -1;
   51: }
   52: 
   53: double ScoreStreamController::window_end_q(int first_bar, int count) const
   54: {
   55:     return composing_ ? program_.slot_start_q(first_bar + count)
   56:                       : slicer_.bar_start_q(first_bar + count);
   57: }
   58: 
   59: bool ScoreStreamController::try_urgent_rewrite(double stream_q)
   60: {
   61:     if (!composing_ || composer_ == nullptr)
   62:         return false;
   63:     // Splice past the playhead's slot plus ONE guard bar: the background
   64:     // engrave takes ~100-200ms, far less than a bar, so the guard bar is the
   65:     // only slot that could play from the OLD window while the new one builds
   66:     // — and its plan is unchanged.
   67:     const int playhead_slot = program_.slot_at(stream_q);
   68:     const int splice = std::min(playhead_slot + 2, program_.size());
   69:     return composer_->plan_urgent(program_, splice) > 0;
   70: }
   71: 
   72: std::optional<ScoreStreamController::WindowSlice> ScoreStreamController::build_window_slice(
   73:     int first_bar)
   74: {
   75:     // The cheap main-thread half of a window advance (slicing + composer
   76:     // planning); the heavy Verovio engrave then runs sync or on the worker.
   77:     const int window_span = 1 + kWindowHistoryBars + kWindowAheadBars;
   78:     WindowSlice slice;
   79:     if (composing_)
   80:     {
   81:         const int available = composer_->ensure(program_, first_bar + window_span);
   82:         first_bar = std::clamp(first_bar, 0, std::max(0, available - 1));
   83:         slice.count = std::min(window_span, available - first_bar);
   84:         std::vector<SourceSlicer::StreamBar> items;
   85:         items.reserve(static_cast<size_t>(slice.count));
   86:         for (int slot = first_bar; slot < first_bar + slice.count; ++slot)
   87:         {
   88:             const StreamBarPlan& plan = program_.plan(slot);
   89:             if (!plan.reason.empty() && slot > last_logged_plan_slot_)
   90:                 DRAXUL_LOG_INFO(
   91:                     LogCategory::App, "stream: slot %d = %s", slot, plan.reason.c_str());
   92:             last_logged_plan_slot_ = std::max(last_logged_plan_slot_, slot);
   93:             SourceSlicer::StreamBar item;
   94:             if (plan.kind == StreamBarPlan::Kind::Drill)
   95:                 item.measure_xml = plan.drill_xml;
   96:             else
   97:                 item.source_bar = plan.source_bar;
   98:             items.push_back(std::move(item));
   99:         }
  100:         slice.xml = slicer_.window_xml_for(items, program_.plan(first_bar).source_bar);
  101:         slice.stream_offset_q = program_.slot_start_q(first_bar);
  102:     }
  103:     else
  104:     {
  105:         const int total = slicer_.bar_count();
  106:         first_bar = std::clamp(first_bar, 0, std::max(0, total - 1));
  107:         slice.count = std::min(window_span, total - first_bar);
  108:         slice.xml = slicer_.window_xml(first_bar, slice.count);
  109:         slice.stream_offset_q = slicer_.bar_start_q(first_bar);
  110:     }
  111:     slice.first_bar = first_bar;
  112:     if (slice.xml.empty())
  113:         return std::nullopt;
  114:     return slice;
  115: }
  116: 
  117: std::optional<int> ScoreStreamController::advance_target(
  118:     double stream_q, int ahead_needed) const
  119: {
  120:     int playhead_bar = 0;
  121:     if (composing_)
  122:     {
  123:         if (composer_->finished() && window_first_bar_ + window_bar_count_ >= program_.size())
  124:             return std::nullopt; // the program is complete and the window reaches its end
  125:         playhead_bar = program_.slot_at(stream_q);
  126:     }
  127:     else
  128:     {
  129:         if (window_first_bar_ + window_bar_count_ >= slicer_.bar_count())
  130:             return std::nullopt; // the window tail already reaches the final bar
  131:         playhead_bar = slicer_.bar_at(stream_q);
  132:     }
  133:     // Advance only when the playhead comes within the viewport's look-ahead
  134:     // of the window's tail — NOT every bar. The background engrave is only
  135:     // ~100 ms while the window still has runway ahead, so the old window
  136:     // keeps playing smoothly until the fresh one installs. It also keeps
  137:     // kWindowHistoryBars behind the playhead so the scroll never clamps.
  138:     const int window_end = window_first_bar_ + window_bar_count_;
  139:     if (playhead_bar <= window_first_bar_ + kWindowHistoryBars
  140:         || playhead_bar < window_end - ahead_needed)
  141:         return std::nullopt;
  142:     return playhead_bar - kWindowHistoryBars;
  143: }
  144: 
  145: bool ScoreStreamController::queue_engrave(
  146:     WindowSlice&& slice, const EngraveParams& params, PendingInstall intent)
  147: {
  148:     WindowEngraver::Job job;
  149:     job.window_xml = std::move(slice.xml);
  150:     job.params = params;
  151:     job.first_bar = slice.first_bar;
  152:     job.count = slice.count;
  153:     job.stream_offset_q = slice.stream_offset_q;
  154:     const WindowEngraver::RequestId request_id = engraver_->submit(std::move(job));
  155:     if (request_id == 0)
  156:         return false;
  157:     intent.request_id = request_id;
  158:     pending_install_ = intent;
  159:     async_in_flight_ = true;
  160:     DRAXUL_LOG_DEBUG(LogCategory::App, "score: queued window generation %llu for bars %d..%d",
  161:         static_cast<unsigned long long>(request_id), slice.first_bar,
  162:         slice.first_bar + slice.count - 1);
  163:     return true;
  164: }
  165: 
  166: void ScoreStreamController::cancel_async()
  167: {
  168:     if (engraver_)
  169:         engraver_->cancel();
  170:     pending_install_.reset();
  171:     async_in_flight_ = false;
  172: }
  173: 
  174: std::optional<ScoreStreamController::Completed> ScoreStreamController::poll_completed()
  175: {
  176:     if (!engraver_)
  177:         return std::nullopt;
  178:     auto done = engraver_->poll();
  179:     if (!done)
  180:         return std::nullopt;
  181:     return filter_completion(std::move(*done));
  182: }
  183: 
  184: std::optional<ScoreStreamController::Completed> ScoreStreamController::filter_completion(
  185:     WindowEngraver::Done done)
  186: {
  187:     if (!pending_install_)
  188:     {
  189:         DRAXUL_LOG_DEBUG(LogCategory::App,
  190:             "score: host discarded unexpected window generation %llu",
  191:             static_cast<unsigned long long>(done.request_id));
  192:         async_in_flight_ = false;
  193:         return std::nullopt;
  194:     }
  195:     if (done.request_id != pending_install_->request_id)
  196:     {
  197:         // A superseded generation must not retire the newest pending
  198:         // install. WindowEngraver normally filters these itself, but
  199:         // retaining the latest request here keeps the stream robust to
  200:         // delayed/fake workers.
  201:         DRAXUL_LOG_DEBUG(LogCategory::App,
  202:             "score: host discarded stale window generation %llu; waiting for %llu",
  203:             static_cast<unsigned long long>(done.request_id),
  204:             static_cast<unsigned long long>(pending_install_->request_id));
  205:         return std::nullopt;
  206:     }
  207:     Completed completed;
  208:     completed.intent = *pending_install_;
  209:     completed.done = std::move(done);
  210:     pending_install_.reset();
  211:     async_in_flight_ = false;
  212:     return completed;
  213: }
