  137: inline std::string DeterministicLayoutEngine::render_timemap()
  138: {
  139:     timemap_rendered_ = true;
  140:     return loaded_ ? std::string(kScoreHostFixtureTimemap) : std::string{};
  141: }
  142: 
  143: inline bool wait_for_loads(const std::shared_ptr<FakeEngineState>& state, int count)
  144: {
  145:     std::unique_lock lock(state->mutex);
  146:     return state->changed.wait_for(
  147:         lock, std::chrono::seconds(2), [&]() { return state->load_calls >= count; });
  148: }
  149: 
  150: inline void release_loads(const std::shared_ptr<FakeEngineState>& state, int count)
  151: {
  152:     std::lock_guard lock(state->mutex);
  153:     state->permits = std::max(state->permits, count);
  154:     state->changed.notify_all();
  155: }
