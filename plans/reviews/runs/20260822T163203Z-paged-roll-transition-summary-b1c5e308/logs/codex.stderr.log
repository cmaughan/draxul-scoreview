  977:     reset_stream_plan();
  978:     rebuild_window(0, 0.0, /*carry=*/false, /*preserve_tempo=*/keep_tempo);
  979:     if (keep_tempo && !lock_tempo_)
  980:         flow_.set_tempo_qpm(tempo);
  981:     if (callbacks_ != nullptr)
