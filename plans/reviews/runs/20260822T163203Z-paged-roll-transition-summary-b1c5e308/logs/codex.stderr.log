  766: bool ScoreRuntime::queue_stream_engrave(int first_bar, double stream_q, bool fallback_to_monolith)
  767: {
  768:     auto slice = stream_->build_window_slice(first_bar);
  769:     if (!slice)
  770:         return false;
  771:     ScoreStreamController::PendingInstall intent;
  772:     intent.stream_position_q = stream_q;
  773:     intent.carry = true;
  774:     intent.preserve_tempo = false;
  775:     intent.fallback_to_monolith_on_error = fallback_to_monolith;
  776:     return stream_->queue_engrave(std::move(*slice), current_engrave_params(), intent);
  777: }
  778: 
  779: ScoreRuntime::FlowBuildResult ScoreRuntime::build_flow_from_engine(std::string& error)
  780: {
  781:     // The whole-piece flow build (Clock conveyor, the `mono` strip, and the
  782:     // initial engraving) shares its extraction with a rolling window; only the
  783:     // transport policy differs. This path leaves the mode/marking to the pump
  784:     // and enter_gate_mode: engrave_loaded reads only the scale/spacing fields,
  785:     // so the marking/lock current_engrave_params() also carries are ignored.
  786:     EngravedWindow engraved;
  787:     const EngraveResult result = engrave_loaded(*engine_, current_engrave_params(), engraved, error);
  788:     if (result == EngraveResult::InterpretFailed)
  789:         return FlowBuildResult::InterpretFailed;
  790:     // Show the strip even when the transport join fails (paged fallback).
  791:     if (engraved.strip)
  792:     {
  793:         strip_ = std::move(engraved.strip);
  794:         highlight_.build(*strip_);
  795:     }
  796:     if (result != EngraveResult::Ok)
  797:         return FlowBuildResult::TransportFailed;
  798:     flow_ = std::move(engraved.flow);
  799:     note_palette_ = std::move(engraved.palette);
  800:     note_staff_ = std::move(engraved.staves);
  801:     waterfall_notes_ = std::move(engraved.waterfall);
  802:     for (const auto& [id, palette] : note_palette_)
  803:         highlight_.set_guidance(id, palette);
  804:     return FlowBuildResult::Ok;
  805: }
  806: 
  807: bool ScoreRuntime::rebuild_window(
  808:     int first_bar, double stream_position_q, bool carry, bool preserve_tempo)
  809: {
  810:     const auto swap_start = std::chrono::steady_clock::now();
  811:     auto slice = stream_->build_window_slice(first_bar);
  812:     if (!slice)
  813:     {
  814:         stream_->cancel_async();
  815:         DRAXUL_LOG_WARN(LogCategory::App, "score: window slice empty, monolithic strip");
  816:         stream_->set_windowed(false);
  817:         flow_dirty_ = true;
  818:         return false;
  819:     }
  820: 
  821:     const EngraveParams params = current_engrave_params();
  822: 
  823:     // Startup performs one synchronous build before interactive frames exist.
  824:     // Every later rebuild uses the latest-wins worker and leaves the current
  825:     // engraving visible until its replacement is ready.
  826:     if (stream_->engraver_available() && stream_->initial_window_installed())
  827:     {
  828:         ScoreStreamController::PendingInstall intent;
  829:         intent.stream_position_q = stream_position_q;
  830:         intent.carry = carry;
  831:         intent.preserve_tempo = preserve_tempo;
  832:         intent.fallback_to_monolith_on_error = false;
  833:         if (!stream_->queue_engrave(std::move(*slice), params, intent))
  834:             return false;
  835:         if (callbacks_ != nullptr)
  836:             callbacks_->request_frame();
  837:         return true;
  838:     }
  839: 
  840:     EngravedWindow engraved;
  841:     std::string error;
  842:     if (engrave_window(*engine_, slice->xml, params, engraved, error) != EngraveResult::Ok)
  843:     {
  844:         DRAXUL_LOG_WARN(LogCategory::App, "score: window build failed (%s), monolithic strip",
  845:             error.c_str());
  846:         stream_->set_windowed(false);
  847:         flow_dirty_ = true; // reload the full piece on the next pump
  848:         return false;
  849:     }
  850:     install_window(std::move(engraved), slice->first_bar, slice->count, slice->stream_offset_q,
  851:         stream_position_q, carry, preserve_tempo);
  852:     const double swap_ms = std::chrono::duration<double, std::milli>(
  853:         std::chrono::steady_clock::now() - swap_start)
  854:                                .count();
  855:     DRAXUL_LOG_DEBUG(LogCategory::App, "score: window -> bars %d..%d (%.1f ms, sync)",
  856:         slice->first_bar, slice->first_bar + slice->count - 1, swap_ms);
  857:     return true;
  858: }
  859: 
  860: void ScoreRuntime::install_window(EngravedWindow&& engraved, int first_bar, int count,
  861:     double stream_offset_q, double stream_position_q, bool carry, bool preserve_tempo)
  862: {
  863:     // engrave_window already set the Roll transport, marking and tempo lock on
  864:     // the incoming flow; carry-over comes from the OUTGOING transport, captured
  865:     // before the move replaces it. Everything here is cheap — no Verovio — so
  866:     // the swap costs a frame at most, not a ~100ms freeze.
  867:     const FlowController::CarryState carried = flow_.carry_state();
  868:     const double outgoing_tempo_qpm = flow_.tempo_qpm();
  869:     const bool was_playing = flow_.playing();
  870: 
  871:     strip_ = std::move(engraved.strip);
  872:     flow_ = std::move(engraved.flow);
  873:     note_palette_ = std::move(engraved.palette);
  874:     note_staff_ = std::move(engraved.staves);
  875:     waterfall_notes_ = std::move(engraved.waterfall);
  876:     rebuild_highlight_from_palette();
  877: 
  878:     stream_->note_installed(first_bar, count, stream_offset_q);
  879: 
  880:     if (carry)
  881:     {
  882:         flow_.restore_carry(carried);
  883:         const double local_position = stream_position_q - stream_->stream_offset_q();
  884:         const double window_end_q = stream_->window_end_q(first_bar, count);
  885:         stream_->verdict_archive().replay(stream_->stream_offset_q(), window_end_q,
  886:             [this](double local_q, int pitch, NoteVerdict verdict) {
  887:                 flow_.preset_verdict(local_q, pitch, verdict);
  888:             });
  889:         flow_.fast_forward_resolved(local_position);
  890:         flow_.seek(local_position);
  891:     }
  892:     else if (preserve_tempo)
  893:     {
  894:         flow_.set_tempo_qpm(outgoing_tempo_qpm);
  895:     }
  896:     if (was_playing)
  897:         flow_.play();
  898:     else
  899:         flow_.pause();
  900:     apply_verdict_update(); // repaint carried verdicts on the fresh strip
  901:     if (callbacks_ != nullptr)
  902:         callbacks_->request_frame();
  903: }
  904: 
  905: void ScoreRuntime::rebuild_highlight_from_palette()
  906: {
  907:     if (!strip_)
  908:         return;
  909:     highlight_.build(*strip_);
  910:     for (const auto& [id, palette] : note_palette_)
  911:         highlight_.set_guidance(id, palette);
  912: }
