   17: std::string now_iso8601()
   18: {
   19:     // LOCAL time, deliberately: the session day feeds the spaced-repetition
   20:     // schedule, whose real quantity is "a night's sleep between encounters"
   21:     // — and sleep happens in the player's timezone. A UTC day boundary put
   22:     // midnight mid-evening for anyone west of Greenwich, letting two
   23:     // same-evening sittings earn day-separated credit.
   24:     const std::time_t t = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
   25:     std::tm tm_local{};
   26: #ifdef _WIN32
   27:     localtime_s(&tm_local, &t);
   28: #else
   29:     localtime_r(&t, &tm_local);
   30: #endif
   31:     char buffer[32];
   32:     std::strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S", &tm_local);
   33:     return buffer;
   34: }
