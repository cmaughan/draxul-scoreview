  209: std::string SourceSlicer::window_xml(int first_bar, int count) const
  210: {
  211:     if (!ready() || first_bar < 0 || count <= 0 || first_bar + count > bar_count())
  212:         return {};
  213:     std::vector<StreamBar> bars;
  214:     bars.reserve(static_cast<size_t>(count));
  215:     for (int bar = first_bar; bar < first_bar + count; ++bar)
  216:         bars.push_back(StreamBar{ bar, {} });
  217:     return window_xml_for(bars, first_bar);
  218: }
