   21: class SourceSlicer
   22: {
   23: public:
   24:     SourceSlicer();
   25:     ~SourceSlicer();
   26: 
   27:     SourceSlicer(const SourceSlicer&) = delete;
   28:     SourceSlicer& operator=(const SourceSlicer&) = delete;
   29: 
   30:     // Parses and indexes the source. False (with `error`) when the XML
   31:     // does not parse or holds no measures.
   32:     bool load(const std::string& musicxml, std::string& error);
   33:     bool ready() const;
   34: 
   35:     int bar_count() const;
   36:     // Bar start on the quarter-note stream axis, accumulated from the
   37:     // notated time signatures (bar 0 starts at 0).
   38:     double bar_start_q(int bar) const;
   39:     double bar_quarters(int bar) const;
   40:     // The bar containing a stream position (clamped to valid bars).
   41:     int bar_at(double stream_q) const;
   42: 
   43:     // A complete MusicXML document containing bars [first, first+count),
   44:     // measures renumbered from 1, attribute state injected at the head.
   45:     // Empty string when out of range.
   46:     std::string window_xml(int first_bar, int count) const;
   47: 
   48:     // One item of a composed window (S3): a source bar cloned verbatim, or
   49:     // a fabricated <measure> (drills). Fabricated bars require a
   50:     // single-part source (the grand staff is one part).
   51:     struct StreamBar
   52:     {
   53:         int source_bar = -1; // >= 0: clone this source bar
   54:         std::string measure_xml; // fabricated <measure>...</measure>
   55:     };
   56:     // A window over an arbitrary bar sequence; head attributes come from
