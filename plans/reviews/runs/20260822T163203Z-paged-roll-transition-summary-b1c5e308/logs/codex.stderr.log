 1001: void ScoreRuntime::maybe_urgent_rewrite()
 1002: {
 1003:     // The rewriting composer: a fumble's correction should not wait a full
 1004:     // engrave window. On the fumble EDGE (the model's monotonic dirty-pass
 1005:     // count advancing), splice the fix just past the playhead and re-engrave
 1006:     // the same window in the background — the sheet ahead of the player
 1007:     // updates while the current window keeps playing. Skipped while a swap
 1008:     // is already in flight or without the async worker (a synchronous
 1009:     // rewrite would freeze mid-play for no urgency win); the append path
 1010:     // (try_reserve) still catches the fumble at the next window then.
 1011:     const int dirty = session_->model().dirty_pass_count();
 1012:     if (dirty == seen_dirty_passes_)
 1013:         return;
 1014:     seen_dirty_passes_ = dirty;
 1015:     if (!stream_active() || flow_.mode() != FlowController::TransportMode::Roll
 1016:         || stream_->async_in_flight() || !stream_->engraver_available())
 1017:         return;
 1018:     const double stream_q = stream_position_q();
 1019:     if (!stream_->try_urgent_rewrite(stream_q))
 1020:         return;
 1021:     if (queue_stream_engrave(
 1022:             stream_->window_first_bar(), stream_q, /*fallback_to_monolith=*/true))
 1023:         DRAXUL_LOG_DEBUG(
 1024:             LogCategory::App, "score: urgent rewrite queued at stream q %.2f", stream_q);
 1025: }
 1026: 
 1027: void ScoreRuntime::maybe_advance_stream()
 1028: {
 1029:     if (!stream_active() || flow_.mode() != FlowController::TransportMode::Roll)
 1030:         return;
 1031:     // A swap is already being engraved in the background; it installs in pump()
 1032:     // (poll_async_engrave). Don't queue a second one.
 1033:     if (stream_->async_in_flight())
 1034:         return;
 1035:     const double stream_q = stream_position_q();
 1036:     const std::optional<int> target = stream_->advance_target(stream_q, presentation_->stream_ahead_needed());
 1037:     if (!target)
 1038:         return;
 1039: 
 1040:     // Slice + plan on the main thread (cheap), then hand the heavy Verovio
 1041:     // engrave to the worker. The current window goes on playing until poll()
 1042:     // installs the result — no freeze, no wall-time catch-up.
 1043:     if (stream_->engraver_available())
 1044:     {
 1045:         queue_stream_engrave(*target, stream_q, /*fallback_to_monolith=*/true);
 1046:         return;
 1047:     }
 1048:     // No worker (creation failed): fall back to the synchronous swap, and don't
 1049:     // charge its wall-time to the transport (else the playhead jumps to catch
 1050:     // up across the freeze).
 1051:     const auto rebuild_start = std::chrono::steady_clock::now();
 1052:     rebuild_window(*target, stream_q, /*carry=*/true);
 1053:     last_pump_ += std::chrono::steady_clock::now() - rebuild_start;
 1054: }
