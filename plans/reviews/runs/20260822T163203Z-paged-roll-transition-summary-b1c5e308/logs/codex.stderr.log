   47: struct SourceSlicer::Impl
   48: {
   49:     XMLDocument document;
   50:     // Everything under <score-partwise> that is not a <part> (part-list,
   51:     // work, identification, defaults...), in order, as XML text.
   52:     std::vector<std::string> header_children;
   53:     struct Part
   54:     {
   55:         std::string id;
   56:         std::vector<const XMLElement*> measures;
   57:         // State accumulated BEFORE each measure (what a window starting
   58:         // here must re-declare).
   59:         std::vector<AttributeState> state_before;
   60:     };
   61:     std::vector<Part> parts;
   62:     std::vector<double> bar_start_q; // size = bar_count + 1
   63: };
