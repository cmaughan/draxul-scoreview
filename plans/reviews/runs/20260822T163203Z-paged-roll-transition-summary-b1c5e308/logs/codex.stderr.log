    1: #pragma once
    2: 
    3: // Player-memory session + persistence (kanban 21, ScoreSessionController):
    4: // the per-piece player model, its content-hash-keyed progress file, the
    5: // session clock, the bar-boundary flush policy, and the cached piece
    6: // analysis with its inspection dump. Owns every filesystem/serialization
    7: // detail; ScoreRuntime keeps only the transport-coupled decisions (tempo
    8: // resume on session start, ending tempo fraction). Internal to
    9: // draxul-scoreview-runtime (no public header).
   10: 
   11: #include <draxul/scoreview/piece_analysis.h>
   12: #include <draxul/scoreview/player_model.h>
   13: 
   14: #include <chrono>
   15: #include <filesystem>
   16: #include <string>
   17: 
   18: namespace draxul
   19: {
   20: namespace scoreview
   21: {
   22: 
   23: class ScoreSessionController
   24: {
   25: public:
   26:     // Keys the progress file by the source bytes (renames keep history) and
   27:     // loads any stored record into the model.
   28:     void attach_source(
   29:         const std::filesystem::path& progress_dir, const std::string& source_bytes);
   30:     bool attached() const
   31:     {
   32:         return !progress_path_.empty();
   33:     }
   34: 
   35:     PlayerModel& model()
   36:     {
   37:         return model_;
   38:     }
   39:     const PlayerModel& model() const
   40:     {
   41:         return model_;
   42:     }
   43: 
   44:     // The upfront analysis (S1), cached for the composer and dumped beside
   45:     // the progress file (<hash>.analysis.json) for inspection.
   46:     const PieceProfile& piece_profile() const
   47:     {
   48:         return profile_;
   49:     }
   50:     void set_piece_profile(PieceProfile profile);
   51: 
   52:     // Session clock. begin_session stamps now and returns whether a fresh
   53:     // session actually started (false when unattached or already active);
   54:     // end_session records the duration + ending tempo fraction and
   55:     // final-flushes. Both are no-ops in the off states.
   56:     bool begin_session();
   57:     void end_session(double end_tempo_frac);
   58: 
   59:     void mark_dirty()
   60:     {
   61:         dirty_ = true;
   62:     }
   63:     // The cheap incremental save: flushes when dirty and the bar changed.
   64:     void flush_at_bar(int bar);
   65:     void save(bool final_flush);
   66:     // Wipes the learning record (keeps the piece identity); callers decide
   67:     // when to re-begin the session and persist.
   68:     void clear_progress();
   69: 
   70: private:
   71:     PlayerModel model_;
   72:     PieceProfile profile_;
   73:     std::filesystem::path progress_path_;
   74:     std::chrono::steady_clock::time_point session_start_{};
   75:     int last_flush_bar_ = -1;
   76:     bool dirty_ = false;
   77: };
