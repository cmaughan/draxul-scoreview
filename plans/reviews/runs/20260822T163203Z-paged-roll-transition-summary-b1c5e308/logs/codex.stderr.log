  807: bool ScoreRuntime::rebuild_window(
  808:     int first_bar, double stream_position_q, bool carry, bool preserve_tempo)
  809: {
  810:     const auto swap_start = std::chrono::steady_clock::now();
  811:     auto slice = stream_->build_window_slice(first_bar);
  812:     if (!slice)
  813:     {
  814:         stream_->cancel_async();
  815:         DRAXUL_LOG_WARN(LogCategory::App, "score: window slice empty, monolithic strip");
  816:         stream_->set_windowed(false);
  817:         flow_dirty_ = true;
  818:         return false;
  819:     }
  820: 
  821:     const EngraveParams params = current_engrave_params();
  822: 
  823:     // Startup performs one synchronous build before interactive frames exist.
  824:     // Every later rebuild uses the latest-wins worker and leaves the current
  825:     // engraving visible until its replacement is ready.
  826:     if (stream_->engraver_available() && stream_->initial_window_installed())
  827:     {
  828:         ScoreStreamController::PendingInstall intent;
  829:         intent.stream_position_q = stream_position_q;
  830:         intent.carry = carry;
  831:         intent.preserve_tempo = preserve_tempo;
  832:         intent.fallback_to_monolith_on_error = false;
  833:         if (!stream_->queue_engrave(std::move(*slice), params, intent))
  834:             return false;
  835:         if (callbacks_ != nullptr)
  836:             callbacks_->request_frame();
  837:         return true;
  838:     }
  839: 
  840:     EngravedWindow engraved;
  841:     std::string error;
  842:     if (engrave_window(*engine_, slice->xml, params, engraved, error) != EngraveResult::Ok)
  843:     {
  844:         DRAXUL_LOG_WARN(LogCategory::App, "score: window build failed (%s), monolithic strip",
  845:             error.c_str());
  846:         stream_->set_windowed(false);
  847:         flow_dirty_ = true; // reload the full piece on the next pump
  848:         return false;
  849:     }
  850:     install_window(std::move(engraved), slice->first_bar, slice->count, slice->stream_offset_q,
  851:         stream_position_q, carry, preserve_tempo);
  852:     const double swap_ms = std::chrono::duration<double, std::milli>(
  853:         std::chrono::steady_clock::now() - swap_start)
  854:                                .count();
  855:     DRAXUL_LOG_DEBUG(LogCategory::App, "score: window -> bars %d..%d (%.1f ms, sync)",
  856:         slice->first_bar, slice->first_bar + slice->count - 1, swap_ms);
  857:     return true;
  858: }
  859: 
  860: void ScoreRuntime::install_window(EngravedWindow&& engraved, int first_bar, int count,
  861:     double stream_offset_q, double stream_position_q, bool carry, bool preserve_tempo)
  862: {
  863:     // engrave_window already set the Roll transport, marking and tempo lock on
  864:     // the incoming flow; carry-over comes from the OUTGOING transport, captured
  865:     // before the move replaces it. Everything here is cheap — no Verovio — so
  866:     // the swap costs a frame at most, not a ~100ms freeze.
  867:     const FlowController::CarryState carried = flow_.carry_state();
  868:     const double outgoing_tempo_qpm = flow_.tempo_qpm();
  869:     const bool was_playing = flow_.playing();
  870: 
  871:     strip_ = std::move(engraved.strip);
  872:     flow_ = std::move(engraved.flow);
  873:     note_palette_ = std::move(engraved.palette);
  874:     note_staff_ = std::move(engraved.staves);
  875:     waterfall_notes_ = std::move(engraved.waterfall);
  876:     rebuild_highlight_from_palette();
  877: 
  878:     stream_->note_installed(first_bar, count, stream_offset_q);
  879: 
  880:     if (carry)
  930:     // always wins, and drills inherit whatever tempo the stream is at.
  931:     if (lock_tempo_ || !stream_active() || flow_.mode() != FlowController::TransportMode::Roll)
  932:         return;
  933:     int source_bar = -1;
  934:     if (const auto source = playhead_source())
  935:         source_bar = source->drill ? -1 : source->source_bar; // drills don't cap
  936:     else if (!stream_->composing() && quarters_per_bar_ > 0.0)
  937:         source_bar = static_cast<int>(stream_position_q() / quarters_per_bar_);
  938:     if (source_bar < 0 || source_bar == ladder_bar_)
  939:         return;
  940:     ladder_bar_ = source_bar;
  941:     // The cap is the MINIMUM rung across the PHRASE containing this bar, not
  942:     // the bar alone: a passage is played no faster than its hardest bar
  943:     // allows (the classic rule), so the pulse stays coherent across the
  944:     // phrase instead of lurching bar-to-bar over the mastery terrain. As
  945:     // every bar in the phrase improves, the phrase's floor rises — all
  946:     // ships. Unplayed bars hold the rung at the start fraction, so the
  947:     // stream never speeds into unread material. Without confident structure
  948:     // the bar's own rung applies (no phrase to be coherent across).
  949:     const PieceProfile& profile = session_->piece_profile();
  950:     double cap_frac = session_->model().bar_tempo_ladder(source_bar);
  951:     int cap_begin = source_bar;
  952:     int cap_end = source_bar + 1;
  953:     if (profile.structure_confidence >= StreamComposer::kMinStructureConfidence)
  954:     {
  955:         if (const PieceProfile::Phrase* phrase = profile.phrase_at_bar(source_bar))
  956:         {
  957:             cap_begin = phrase->start_bar;
  958:             cap_end = phrase->end_bar;
  959:             for (int bar = phrase->start_bar; bar < phrase->end_bar; ++bar)
  960:                 cap_frac = std::min(cap_frac, session_->model().bar_tempo_ladder(bar));
  961:         }
  962:     }
  963:     const double cap_qpm = flow_.marking_qpm() * cap_frac;
  964:     if (flow_.tempo_qpm() > cap_qpm)
  965:     {
  966:         flow_.set_tempo_qpm(cap_qpm);
  967:         DRAXUL_LOG_DEBUG(LogCategory::App,
  968:             "score: tempo ladder caps bars %d..%d at %.0f qpm (weakest rung %.2f)",
  969:             cap_begin + 1, cap_end, cap_qpm, cap_frac);
  970:     }
  971: }
