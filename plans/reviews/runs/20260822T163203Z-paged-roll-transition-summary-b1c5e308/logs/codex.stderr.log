  300: void ScoreRuntime::quiesce()
  301: {
  302:     if (quiesced_)
  303:         return;
  304:     end_progress_session();
  305:     // Stop the background engraver first: its destructor signals the worker and
  306:     // joins it (bounded by one in-flight engrave), so nothing races teardown.
  307:     stream_->reset_engraver();
  308:     release_input_device();
  309:     release_audio_output();
  310:     audio_->shutdown();
  311:     running_ = false;
  312:     quiesced_ = true;
  313: }
