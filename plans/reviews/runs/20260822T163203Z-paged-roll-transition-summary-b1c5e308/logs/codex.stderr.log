 1146: void ScoreRuntime::apply_verdict_update()
 1147: {
 1148:     const FlowController::VerdictUpdate update = flow_.take_verdict_update();
 1149:     if (update.reset)
 1150:         highlight_.clear_lit();
 1151:     // Wrong-note marking can be turned off to read the pure notation (the flow
 1152:     // controller still tracks hits/misses for scoring — only the on-sheet
 1153:     // cross is suppressed). Verdicts never recolor the note; a wrong one is
 1154:     // flagged by a cross the renderer draws over the Missed state.
 1155:     if (!mark_mistakes_)
 1156:         return;
 1157:     for (const auto& [id, verdict] : update.changes)
 1158:     {
 1159:         highlight_.set_state(id,
 1160:             verdict == FlowController::NoteVerdict::Missed ? ScoreHighlightState::State::Missed
 1240:     }
 1241:     if (audio_->ensure_output_stream())
 1242:     {
 1243:         device_error_.clear();
 1244:         return true;
 1245:     }
 1246:     device_error_ = "default audio output is unavailable";
 1247:     release_audio_output();
 1248:     return false;
 1249: }
