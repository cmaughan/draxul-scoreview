   76: bool ScoreSessionController::begin_session()
   77: {
   78:     if (progress_path_.empty() || model_.session_active())
   79:         return false;
   80:     model_.begin_session(now_iso8601());
   81:     session_start_ = std::chrono::steady_clock::now();
   82:     return true;
   83: }
   84: 
   85: void ScoreSessionController::end_session(double end_tempo_frac)
   86: {
   87:     if (!model_.session_active())
   88:         return;
   89:     const int seconds = static_cast<int>(std::chrono::duration_cast<std::chrono::seconds>(
   90:         std::chrono::steady_clock::now() - session_start_)
   91:             .count());
   92:     model_.end_session(seconds, end_tempo_frac);
   93:     save(/*final_flush=*/true);
   94: }
   95: 
   96: void ScoreSessionController::flush_at_bar(int bar)
   97: {
   98:     if (bar == last_flush_bar_)
   99:         return;
  100:     last_flush_bar_ = bar;
  101:     if (dirty_)
  102:         save(/*final_flush=*/false);
  103: }
  104: 
  105: void ScoreSessionController::save(bool final_flush)
  106: {
  107:     if (progress_path_.empty())
  108:         return;
  109:     std::string error;
  110:     if (!save_progress_atomic(progress_path_, model_.serialize(), error))
  111:     {
  112:         DRAXUL_LOG_WARN(LogCategory::App, "score: progress save failed: %s", error.c_str());
  113:         return;
  114:     }
  115:     dirty_ = false;
  116:     if (final_flush)
  117:     {
  118:         DRAXUL_LOG_INFO(LogCategory::App, "score: progress saved — %d notes total, %s",
  119:             model_.total_notes_judged(), progress_path_.string().c_str());
  120:     }
  121: }
  122: 
  123: void ScoreSessionController::clear_progress()
  124: {
  125:     model_.clear_progress();
  126: }
