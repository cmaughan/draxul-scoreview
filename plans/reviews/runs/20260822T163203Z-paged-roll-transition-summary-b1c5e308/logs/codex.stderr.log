    3: // The ONE blockable, deterministic fake layout engine shared by every
    4: // ScoreView suite (host orchestration/rebuild, worker stress, and the layout
    5: // tests' engraver-lifetime cases). load() records its payload and (optionally)
    6: // waits until the test grants a permit, so worker interleavings are driven,
    7: // not raced; fail_load makes the engrave report a deterministic failure and
    8: // the destroyed counter proves teardown owns the engine.
    9: 
   10: #include <draxul/scoreview/layout_engine.h>
   11: 
   12: #include <algorithm>
   13: #include <chrono>
   14: #include <condition_variable>
   15: #include <memory>
   16: #include <mutex>
   17: #include <string>
   18: #include <string_view>
   19: #include <vector>
   20: 
   21: namespace draxul
   22: {
   23: namespace scoreview
   24: {
   25: 
   26: struct FakeEngineState
   27: {
   28:     std::mutex mutex;
   29:     std::condition_variable changed;
   30:     int load_calls = 0;
   31:     int permits = 0;
   32:     int destroyed = 0;
   33:     std::vector<std::string> payloads;
   34: };
   35: 
   36: class DeterministicLayoutEngine final : public ILayoutEngine
   37: {
   38: public:
   39:     DeterministicLayoutEngine(
   40:         std::shared_ptr<FakeEngineState> state, std::string svg, bool block_load,
   41:         bool require_timemap_for_midi = false, bool fail_load = false)
   42:         : state_(std::move(state))
   43:         , svg_(std::move(svg))
   44:         , block_load_(block_load)
   45:         , require_timemap_for_midi_(require_timemap_for_midi)
   46:         , fail_load_(fail_load)
   47:     {
   48:     }
   49: 
   50:     ~DeterministicLayoutEngine() override
   51:     {
   52:         std::lock_guard lock(state_->mutex);
   53:         ++state_->destroyed;
   54:         state_->changed.notify_all();
   55:     }
   56: 
   57:     bool load(std::string_view bytes, std::string& error) override
   58:     {
   59:         std::unique_lock lock(state_->mutex);
   60:         ++state_->load_calls;
   61:         const int call = state_->load_calls;
   62:         state_->payloads.emplace_back(bytes);
   63:         state_->changed.notify_all();
   64:         if (block_load_)
   65:             state_->changed.wait(lock, [&]() { return state_->permits >= call; });
   66:         if (fail_load_)
   67:         {
   68:             error = "deterministic fake engraving failure";
   69:             return false;
   70:         }
   71:         loaded_ = true;
   72:         error.clear();
   73:         return true;
   74:     }
   75: 
   76:     void set_options(const LayoutOptions&) override {}
   77:     bool is_loaded() const override
   78:     {
   79:         return loaded_;
   80:     }
   81:     int page_count() override
   82:     {
   83:         return loaded_ ? 1 : 0;
   84:     }
   85:     std::string render_page_svg(int page_number) override
   86:     {
   87:         return loaded_ && page_number == 1 ? svg_ : std::string{};
   88:     }
   89:     std::string render_timemap() override;
   90:     int midi_pitch_for_element(const std::string& element_id) override
   91:     {
   92:         if (require_timemap_for_midi_ && !timemap_rendered_)
   93:             return -1;
   94:         return element_id == "usfythd" ? 60 : -1;
   95:     }
   96:     int note_letter_for_element(const std::string& element_id) override
   97:     {
   98:         return element_id == "usfythd" ? 0 : -1;
   99:     }
  100:     std::vector<std::string> tie_end_ids() override
  101:     {
  102:         return {};
  103:     }
  104: 
  105: private:
  106:     std::shared_ptr<FakeEngineState> state_;
  107:     std::string svg_;
  108:     bool block_load_ = false;
  109:     bool require_timemap_for_midi_ = false;
  110:     bool fail_load_ = false;
  111:     bool timemap_rendered_ = false;
  112:     bool loaded_ = false;
  113: };
