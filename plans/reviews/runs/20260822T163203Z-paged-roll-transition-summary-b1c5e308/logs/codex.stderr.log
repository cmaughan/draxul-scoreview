 1448: void ScoreRuntime::begin_progress_session()
 1449: {
 1450:     if (!session_->begin_session())
 1451:         return;
 1452:     // Resume at yesterday's pace: the stored tempo informs the start, still
 1453:     // clamped to the marking band. Fresh pieces keep the 60% default. The
 1454:     // tempo lock overrides this — it holds the marking regardless.
 1455:     if (!lock_tempo_ && session_->model().last_tempo_frac() > 0.0 && flow_.ready())
 1456:         flow_.set_tempo_qpm(flow_.marking_qpm() * session_->model().last_tempo_frac());
 1457: }
 1458: 
 1459: void ScoreRuntime::end_progress_session()
 1460: {
 1461:     session_->end_session(
 1462:         flow_.marking_qpm() > 0.0 ? flow_.tempo_qpm() / flow_.marking_qpm() : 0.0);
 1463: }
 1464: 
 1465: void ScoreRuntime::clear_piece_progress()
 1466: {
 1467:     session_->clear_progress();
 1468:     begin_progress_session(); // session_active_ is false after clear — starts fresh
 1469:     session_->save(/*final_flush=*/false); // overwrite the file with the cleared model
 1470:     // Restart the stream from the top so the composer re-plans against a blank
 1471:     // slate. A cleared record is the one restart that RESETS the tempo — a
 1472:     // fresh learner starts at the 60% ramp again.
 1473:     restart_stream(/*keep_tempo=*/false);
 1474:     DRAXUL_LOG_INFO(LogCategory::App, "score: cleared progress for this piece");
 1475: }
