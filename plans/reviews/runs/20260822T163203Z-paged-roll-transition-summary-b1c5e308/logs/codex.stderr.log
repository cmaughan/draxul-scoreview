   57: void ScoreSessionController::set_piece_profile(PieceProfile profile)
   58: {
   59:     profile_ = std::move(profile);
   60:     DRAXUL_LOG_INFO(LogCategory::App,
   61:         "score: analysis — key %s (%.2f), %zu chord(s), %zu motif(s), %zu figure(s)",
   62:         key_name(profile_.global_key.tonic_pc, profile_.global_key.minor).c_str(),
   63:         profile_.global_key.confidence, profile_.chords.size(), profile_.motifs.size(),
   64:         profile_.figures.size());
   65:     if (!progress_path_.empty())
   66:     {
   67:         std::filesystem::path analysis_path = progress_path_;
   68:         analysis_path.replace_extension(".analysis.json");
   69:         std::string save_error;
   70:         if (!save_progress_atomic(analysis_path, profile_.serialize(), save_error))
   71:             DRAXUL_LOG_WARN(
   72:                 LogCategory::App, "score: analysis dump failed: %s", save_error.c_str());
   73:     }
   74: }
