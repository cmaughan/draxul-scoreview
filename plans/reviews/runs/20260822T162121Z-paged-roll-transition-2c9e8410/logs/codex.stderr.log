  42:     out.flow.prepare_gates(
  43:         [&engine](const std::string& id) { return engine.midi_pitch_for_element(id); },
  44:         engine.tie_end_ids());
  45: 
  46:     // Whole-window coloring: resolve each note's spelling once (the engine
  47:     // knows its notated letter here) into the pairing palette.
  48:     out.palette.clear();
  49:     out.staves.clear();
