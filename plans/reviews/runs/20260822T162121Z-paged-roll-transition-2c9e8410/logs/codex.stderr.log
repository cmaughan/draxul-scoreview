 1489: void ScoreRuntime::pump()
 1490: {
 1491:     const auto now = std::chrono::steady_clock::now();
 1492:     // Clamp long stalls (first frame, app pauses) to one frame's worth.
 1493:     const double dt = std::clamp(std::chrono::duration<double>(now - last_pump_).count(), 0.0, 0.1);
 1494:     last_pump_ = now;
 1495: 
 1496:     // Poll regardless of transport/view state: paused spacing changes and
 1497:     // invalidated jobs must still retire. Synchronous main-engine layouts are
 1498:     // deferred while the worker toolkit is active, preserving the existing
 1499:     // no-concurrent-Verovio invariant without blocking this frame.
 1500:     poll_async_engrave();
 1501:     const bool background_engrave_active = stream_->engrave_busy();
 1502:     if (view_mode_ == ViewMode::Flow && flow_dirty_ && !background_engrave_active)
 1503:         relayout_flow();
 1504:     if (view_mode_ == ViewMode::Paged && layout_dirty_ && !background_engrave_active)
 1505:         relayout();
 1506: 
 1507:     if (view_mode_ == ViewMode::Flow && flow_.playing())
 1508:     {
 1509:         const double position_before_q = flow_.position_q();
 1510:         flow_.advance(dt);
 1511:         if (audio_->wants_pump())
 1512:         {
