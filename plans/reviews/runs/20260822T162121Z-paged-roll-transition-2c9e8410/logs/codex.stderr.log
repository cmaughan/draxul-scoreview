 160:     static void relayout_paged(ScoreHost& host, int width = 800, int height = 600)
 161:     {
 162:         host.viewport_.pixel_size = { width, height };
 163:         host.viewport_.pixel_scale = 1.0f;
 164:         host.view_mode_ = ScoreHost::ViewMode::Paged;
 165:         host.relayout();
 166:     }
