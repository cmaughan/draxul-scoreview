 146:     // Input selection (kanban 15/16): the same swap-in-place path the UI
 147:     // uses. Mic is deliberately not offered here — it would touch the real
 148:     // permission/device layer; MicPlayerInput has its own fake-ops suite.
 149:     static bool select_input(
 150:         ScoreHost& host, GateInput input, int midi_port = -1)
 151:     {
