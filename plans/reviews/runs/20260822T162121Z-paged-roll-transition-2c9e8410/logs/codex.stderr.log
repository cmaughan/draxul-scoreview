  92:     }
  93:     // Notes without an explicit off (final ties) run to the piece end.
  94:     for (const auto& [id, onset] : open)
  95:     {
  96:         auto [note, ok] = note_for(id, onset, timemap->duration_q);
  97:         if (ok)
  98:             out.waterfall.push_back(note);
  99:     }
 100:     return EngraveResult::Ok;
 101: }
 102: 
 103: EngraveResult engrave_window(ILayoutEngine& engine, const std::string& window_xml,
 104:     const EngraveParams& params, EngravedWindow& out, std::string& error)
 105: {
 106:     if (window_xml.empty() || !engine.load(window_xml, error))
 107:         return EngraveResult::InterpretFailed;
 108: 
 109:     const EngraveResult result = engrave_loaded(engine, params, out, error);
 110:     if (result != EngraveResult::Ok)
 111:         return result;
 112: 
 113:     // Roll transport policy for a rolling window: the piece's marking (the
 114:     // slice lost the bar-1 tempo text), no adaptation while locked.
 115:     out.flow.set_marking_qpm(params.marking_qpm);
 116:     out.flow.set_mode(FlowController::TransportMode::Roll);
 117:     out.flow.set_adapt_tempo(!params.lock_tempo);
 118:     if (params.lock_tempo && params.marking_qpm > 0.0)
 119:         out.flow.set_tempo_qpm(params.marking_qpm);
 120:     return result;
 121: }
