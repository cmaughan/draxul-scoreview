 168:     static size_t paged_guided_glyph_count(const ScoreHost& host)
 169:     {
 170:         size_t guided = 0;
 171:         if (!host.page_note_highlights_)
 172:             return 0;
 173:         for (const ScoreHighlightState& colors : *host.page_note_highlights_)
 174:         {
 175:             for (const uint8_t guide : colors.glyph_guide)
 176:                 guided += guide != 0 ? 1 : 0;
 177:         }
 178:         return guided;
 179:     }
