 208:     static FlowController::TransportMode transport_mode(const ScoreHost& host)
 209:     {
 210:         return host.flow_.mode();
 211:     }
 212: 
 213:     static bool stream_active(const ScoreHost& host)
 214:     {
 215:         return host.stream_active();
 216:     }
 217: 
 218:     static size_t waterfall_note_count(const ScoreHost& host)
 219:     {
 220:         return host.waterfall_notes_.size();
 221:     }
