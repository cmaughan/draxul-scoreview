 222: TEST_CASE("input selection swaps in place and reports requested-vs-engaged",
 223:     "[scoreview][host][orchestration][input]")
 224: {
 225:     PrimedHost primed;
 226:     REQUIRE(primed.prime());
 227:     ScoreHostTestAccess::set_transport(primed.host, 1.5, 96.0, true);
 228:     const double position = ScoreHostTestAccess::position_q(primed.host);
 229:     const double tempo = ScoreHostTestAccess::tempo_qpm(primed.host);
 230: 
 231:     using GateInput = ScoreHostTestAccess::GateInput;
 232:     CHECK(ScoreHostTestAccess::select_input(primed.host, GateInput::Keyboard));
 233:     CHECK(ScoreHostTestAccess::input_kind(primed.host) == PlayerInputRig::Kind::Keyboard);
 234: 
 235:     // A MIDI request with no device engages the keyboard instead and says so.
 236:     CHECK_FALSE(ScoreHostTestAccess::select_input(
 237:         primed.host, GateInput::Midi, /*midi_port=*/-1));
 238:     CHECK(ScoreHostTestAccess::input_kind(primed.host) == PlayerInputRig::Kind::Keyboard);
 239: 
 240:     // The bot always engages (deterministic verification player).
 241:     CHECK(ScoreHostTestAccess::select_input(primed.host, GateInput::Bot));
 242:     CHECK(ScoreHostTestAccess::input_kind(primed.host) == PlayerInputRig::Kind::Bot);
 243: 
 244:     // Swaps never touch the session: transport survives every switch.
 245:     CHECK(ScoreHostTestAccess::position_q(primed.host) == Catch::Approx(position));
 246:     CHECK(ScoreHostTestAccess::tempo_qpm(primed.host) == Catch::Approx(tempo));
 247:     CHECK(ScoreHostTestAccess::playing(primed.host));
 248: }
