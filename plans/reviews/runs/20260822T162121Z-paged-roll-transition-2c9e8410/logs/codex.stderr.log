 1110: void ScoreRuntime::toggle_flow_mode()
 1111: {
 1112:     if (!engine_ || !engine_->is_loaded())
 1113:         return;
 1114:     stream_->cancel_async();
 1115:     if (view_mode_ == ViewMode::Paged)
 1116:     {
 1117:         view_mode_ = ViewMode::Flow;
 1118:         flow_dirty_ = true; // re-engrave as the strip on the next pump
 1119:         // Returning to the runner: request Roll before the flow build primes
 1120:         // the slicer. The build then installs a rolling window when supported
 1121:         // or applies its existing whole-piece fallback.
 1122:         if (game_mode_ == FlowController::TransportMode::Roll)
 1123:             start_in_gate_ = true;
 1124:     }
 1125:     else
 1126:     {
 1127:         if (flow_.mode() == FlowController::TransportMode::Gate)
 1128:             exit_gate_mode();
 1129:         view_mode_ = ViewMode::Paged;
 1130:         flow_.pause();
 1131:         layout_dirty_ = true; // re-engrave pages; scroll_y_ carries over
 1132:     }
 1133:     if (callbacks_ != nullptr)
 1134:         callbacks_->request_frame();
 1135: }
