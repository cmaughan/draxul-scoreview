 236: inline bool wait_for_host_install(ScoreHost& host)
 237: {
 238:     for (int attempt = 0; attempt < 400; ++attempt)
 239:     {
 240:         ScoreHostTestAccess::poll(host);
 241:         if (!ScoreHostTestAccess::async_pending(host))
 242:             return true;
 243:         std::this_thread::sleep_for(std::chrono::milliseconds(5));
 244:     }
 245:     return false;
 246: }
