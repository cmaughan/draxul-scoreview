  190:         game_mode_ = FlowController::TransportMode::Roll;
  191:         const std::string& command = mode;
  192:         if (command.find("paged") != std::string::npos)
  193:         {
  194:             view_mode_ = ViewMode::Paged;
  195:             flow_dirty_ = false;
  196:             start_in_gate_ = false;
  197:         }
  198:         else if (command.find("gate") != std::string::npos)
  199:         {
  200:             game_mode_ = FlowController::TransportMode::Gate;
  201:             if (command.find("bot") != std::string::npos)
  202:                 gate_input_requested_ = GateInput::Bot;
  203:             else if (command.find("mic") != std::string::npos)
  204:                 gate_input_requested_ = GateInput::Mic;
  205:             gate_bot_accuracy_ = command.find("err") != std::string::npos ? 0.7 : 1.0;
  206:         }
  207:         else if (command.find("roll") != std::string::npos)
  208:         {
  209:             if (command.find("mic") != std::string::npos)
  210:                 gate_input_requested_ = GateInput::Mic;
  211:         }
  212:         else if (command.find("flow") != std::string::npos)
  213:         {
  214:             start_in_gate_ = false;
  215:             flow_autoplay_ = command.find("autoplay") != std::string::npos;
  216:         }
  217:         // `mono` disables the rolling window (the monolithic-strip
  218:         // verification instrument for window-equivalence checks).
  219:         if (command.find("mono") != std::string::npos)
  220:             stream_->set_windowed(false);
  221:         // The metronome defaults ON with subdivisions; `notick`/`tick`/
  222:         // `tick8` tokens override from launch (dev/test).
  223:         if (command.find("notick") != std::string::npos)
  224:             audio_->set_tick_level(ScoreAudioController::TickLevel::Off);
  225:         if (command.find("notes") != std::string::npos)
  226:             audio_->set_audition(true);
  227:         if (command.find("nowaterfall") != std::string::npos)
  228:             show_waterfall_ = false;
  229:         if (command.find("noverdict") != std::string::npos
  230:             || command.find("nomistake") != std::string::npos)
  231:             mark_mistakes_ = false;
  232:         if (command.find("fullcolor") != std::string::npos)
  233:             split_accidentals_ = false;
  234:         // The green analysis annotations over the paged reading view (the
  235:         // inspector's "Analysis overlay"); launch token for headless
  560:             continue;
  561:         }
  562:         for (const std::string& warning : list->warnings)
  563:             DRAXUL_LOG_DEBUG(
  564:                 LogCategory::App, "score page %d interpreter: %s", page, warning.c_str());
  565:         pages->push_back(std::move(*list));
  566:     }
  567: 
  568:     pages_ = pages;
  569:     auto page_colors = std::make_shared<std::vector<ScoreHighlightState>>();
  570:     page_colors->reserve(pages_->size());
  571:     for (const ScoreDrawList& page : *pages_)
  572:     {
  573:         ScoreHighlightState colors;
  574:         colors.build(page);
  575:         page_colors->push_back(std::move(colors));
  576:     }
  577:     std::string color_timemap_error;
  578:     const auto color_timemap = parse_timemap(engine_->render_timemap(), color_timemap_error);
  579:     if (color_timemap)
  580:     {
  581:         std::unordered_set<std::string> note_ids;
  582:         for (const TimemapEntry& entry : color_timemap->entries)
  583:             note_ids.insert(entry.note_on.begin(), entry.note_on.end());
  584:         for (const std::string& id : note_ids)
  585:         {
  586:             const int midi = engine_->midi_pitch_for_element(id);
  587:             if (midi < 0)
  588:                 continue;
  589:             const int palette
  590:                 = guidance_palette_index(midi, engine_->note_letter_for_element(id));
  591:             for (ScoreHighlightState& colors : *page_colors)
  592:                 colors.set_guidance(id, palette);
  593:         }
  594:     }
  595:     else
  596:     {
  597:         DRAXUL_LOG_DEBUG(LogCategory::App,
  598:             "score: full-score note colors unavailable: %s", color_timemap_error.c_str());
  599:     }
  600:     page_note_highlights_ = page_colors;
  601:     rebuild_analysis_overlay();
  602:     size_t total_ops = 0;
  603:     for (const ScoreDrawList& page : *pages_)
  604:         total_ops += page.glyphs.size() + page.paths.size() + page.texts.size();
  605:     DRAXUL_LOG_INFO(LogCategory::App, "score: engraved %zu page(s), %zu draw ops (%dpx wide, zoom %.0f%%)",
  606:         pages_->size(), total_ops, avail_w, static_cast<double>(zoom_) * 100.0);
  607:     if (!pages_->empty() && pages_->front().canvas_size.x > 0.0f)
  608:     {
  609:         const ScoreDrawList& first = pages_->front();
  610:         page_width_px_ = static_cast<float>(avail_w);
  611:         page_scale_ = page_width_px_ / first.canvas_size.x;
  612:         page_height_px_ = first.canvas_size.y * page_scale_;
  613:     }
  614:     layout_dirty_ = false;
  615:     scroll_y_ = std::clamp(scroll_y_, 0.0f, max_scroll());
  616:     if (callbacks_ != nullptr)
  617:         callbacks_->request_frame();
  618: }
