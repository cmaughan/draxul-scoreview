 1477: int ScoreRuntime::approx_measure() const
 1478: {
 1479:     if (!flow_.ready() || !has_model_)
 1480:         return 0;
 1481:     const double quarters_per_measure = quarters_per_measure_from_model();
 1482:     if (quarters_per_measure <= 0.0)
 1483:         return 0;
 1484:     if (const auto source = playhead_source())
 1485:         return source->source_bar + 1; // a drill shows its reference bar
 1486:     return static_cast<int>(stream_position_q() / quarters_per_measure) + 1;
 1487: }
