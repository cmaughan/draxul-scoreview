 136: TEST_CASE("shutdown retires a completed but uninstalled window generation",
 137:     "[scoreview][host][orchestration]")
 138: {
 139:     PrimedHost primed;
 140:     REQUIRE(primed.prime());
 141: 
 142:     // A blockable worker completes an engrave the host never polls.
 143:     auto worker_state = std::make_shared<FakeEngineState>();
 144:     std::string error;
 145:     auto engraver = WindowEngraver::create(
 146:         std::make_unique<DeterministicLayoutEngine>(
 147:             worker_state, read_verovio_svg_fixture(), true),
 148:         error);
 149:     REQUIRE(engraver);
 150:     ScoreHostTestAccess::inject_engraver(primed.host, std::move(engraver));
 151: 
 152:     ScoreHostTestAccess::restyle_current_window(primed.host);
 153:     REQUIRE(ScoreHostTestAccess::pending_request(primed.host) != 0);
 154:     release_loads(worker_state, 1);
 155:     REQUIRE(wait_for_loads(worker_state, 1));
 156: 
 157:     // No poll: the finished generation is still queued when the host goes
 158:     // down. Shutdown must join the worker and drop the pending install
 159:     // without hanging or installing into a dead presentation.
 160:     primed.host.shutdown();
 161:     CHECK_FALSE(primed.host.is_running());
 162: }
