 1263: void ScoreRuntime::enter_gate_mode(
 1264:     GateInput input, double bot_pace_qpm, double bot_accuracy, int midi_port)
 1265: {
 1266:     if (!flow_.gates_ready())
 1267:         return;
 1268:     if (game_mode_ == FlowController::TransportMode::Roll && stream_->windowed() && stream_->slicer().ready())
 1269:     {
 1270:         // The runner plays on the rolling window from stream bar 0, with
 1271:         // a fresh program (mastery persists in the player model, not here).
 1272:         stream_->verdict_archive().clear();
 1273:         reset_stream_plan();
 1274:         if (!rebuild_window(0, 0.0, /*carry=*/false))
 1275:             flow_.set_mode(game_mode_); // fell back to the monolithic strip
 1276:         else if (stream_->async_in_flight())
 1277:             flow_.set_mode(game_mode_); // old strip stays interactive while replacing it
 1278:     }
 1279:     else
 1280:     {
 1281:         flow_.set_mode(game_mode_);
 1282:     }
 1283:     highlight_.clear_lit();
 1284:     apply_verdict_update(); // consume the reset
 1285:     set_gate_input(input, bot_pace_qpm, bot_accuracy, midi_port);
 1286:     // The gate transport starts immediately for every input: it just glides
 1287:     // to the first onset and WAITS there. Space pauses/resumes.
 1288:     flow_.play();
 1289:     if (game_mode_ == FlowController::TransportMode::Roll)
 1290:         begin_progress_session();
 1291:     last_logged_gate_ = 0;
 1292:     logged_gate_end_ = false;
 1293:     if (callbacks_ != nullptr)
 1294:         callbacks_->request_frame();
 1295: }
 1296: 
 1297: void ScoreRuntime::exit_gate_mode()
 1298: {
 1299:     end_progress_session();
 1300:     stream_->cancel_async();
 1301:     release_input_device();
 1302:     flow_.set_mode(FlowController::TransportMode::Clock);
 1303:     if (stream_active())
 1304:     {
 1305:         // The engine holds a window document; the clock conveyor wants the
 1306:         // whole piece back (relayout_flow reloads the source).
 1307:         stream_->verdict_archive().clear();
 1308:         flow_dirty_ = true;
 1309:     }
 1310:     highlight_.clear_lit();
 1311:     apply_lit_update(); // consume the reset; re-light anything at q <= 0
 1312:     if (callbacks_ != nullptr)
 1313:         callbacks_->request_frame();
 1314: }
 1315: 
 1470:     // Restart the stream from the top so the composer re-plans against a blank
 1471:     // slate. A cleared record is the one restart that RESETS the tempo — a
 1472:     // fresh learner starts at the 60% ramp again.
 1473:     restart_stream(/*keep_tempo=*/false);
 1474:     DRAXUL_LOG_INFO(LogCategory::App, "score: cleared progress for this piece");
 1475: }
