 250: TEST_CASE("process device leases reject contention and release deterministically",
 251:     "[scoreview][host][orchestration][devices]")
 252: {
 253:     using draxul::scoreview::ScoreDeviceKind;
 254:     auto provider = draxul::scoreview::create_score_device_lease_provider();
 255:     int first_owner = 1;
 256:     int second_owner = 2;
 257: 
 258:     auto first = provider->acquire(
 259:         ScoreDeviceKind::AudioOutput, "default", &first_owner);
 260:     REQUIRE(first.lease);
 261:     CHECK(first.error.empty());
 262: 
 263:     auto conflict = provider->acquire(
 264:         ScoreDeviceKind::AudioOutput, "default", &second_owner);
 265:     CHECK_FALSE(conflict.lease);
 266:     CHECK(conflict.error.find("another ScoreView pane") != std::string::npos);
 267: 
 268:     auto other_device = provider->acquire(
 269:         ScoreDeviceKind::MidiInput, "Piano A", &second_owner);
 270:     CHECK(other_device.lease);
 271: 
 272:     first.lease.reset();
 273:     auto handed_off = provider->acquire(
 274:         ScoreDeviceKind::AudioOutput, "default", &second_owner);
 275:     CHECK(handed_off.lease);
 276: }
