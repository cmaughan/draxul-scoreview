  33: 
  34:     // Keep the strip even if the transport join fails: a failed window can
  35:     // still fall back to showing the engraving.
  36:     out.strip = std::make_shared<const ScoreDrawList>(std::move(*strip));
  37:     auto timemap = parse_timemap(engine.render_timemap(), error);
  38:     if (!timemap.has_value() || !out.flow.build(*timemap, *out.strip, error))
  39:         return EngraveResult::TransportFailed;
