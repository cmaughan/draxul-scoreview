 248: // Counting IHostCallbacks: proves the host requests frames (and nothing
 249: // else) without a window; lifetime is the test's, so use-after-shutdown
 250: // would trip sanitizers.
 251: class CountingHostCallbacks final : public ScoreRuntimeCallbacks
 252: {
 253: public:
 254:     void request_frame() override
 255:     {
 256:         ++frames;
 257:     }
 258:     int frames = 0;
 259: };
