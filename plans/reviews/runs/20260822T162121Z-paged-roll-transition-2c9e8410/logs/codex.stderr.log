  74: TEST_CASE("a sourceless host runs one full headless lifecycle",
  75:     "[scoreview][host][orchestration]")
  76: {
  77:     auto callbacks = std::make_unique<CountingHostCallbacks>();
  78:     auto host = std::make_unique<ScoreHost>();
  79: 
  80:     PluginRuntimeContext context;
  81:     context.initial_viewport = viewport(800, 600);
  82:     REQUIRE(host->initialize(context, *callbacks));
  83:     CHECK(host->is_running());
  84:     CHECK(host->init_error().empty());
  85: 
  86:     // The placeholder page: pump, interrogate, resize — no GPU touched.
  87:     for (int frame = 0; frame < 3; ++frame)
  88:         host->pump();
  89:     CHECK_FALSE(host->status_text().empty());
  90:     (void)host->runtime_state();
  91:     (void)host->debug_state();
  92:     (void)host->print_hint();
  93:     (void)host->default_background();
  94:     host->set_viewport(viewport(1024, 768));
  95:     host->pump();
  96: 
  97:     host->shutdown();
  98:     CHECK_FALSE(host->is_running());
  99:     host->shutdown(); // idempotent
 100:     CHECK_FALSE(host->is_running());
 101: 
 102:     // Callbacks must not be reached after shutdown: destroy the host while
 103:     // the callbacks object is still alive, then release the callbacks.
 104:     const int frames_at_shutdown = callbacks->frames;
 105:     host.reset();
 106:     CHECK(callbacks->frames == frames_at_shutdown);
 107: }
