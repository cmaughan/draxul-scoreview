  94:         host.restart_stream(true);
  95:     }
  96: 
  97:     static void restyle_current_window(ScoreHost& host)
  98:     {
  99:         host.proportional_spacing_ = !host.proportional_spacing_;
 100:         host.reengrave_flow_in_place();
 101:     }
 102: 
 103:     static void poll(ScoreHost& host)
 104:     {
 105:         host.poll_async_engrave();
 106:     }
 107: 
 108:     static void deliver_stale_completion(ScoreHost& host, WindowEngraver::RequestId request_id)
 109:     {
 110:         WindowEngraver::Done done;
 111:         done.request_id = request_id;
 112:         done.ok = true;
 113:         host.handle_async_engrave_done(std::move(done));
 114:     }
