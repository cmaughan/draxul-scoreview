  924: void ScoreRuntime::apply_tempo_ladder()
  925: {
  926:     // The per-bar tempo ladder (C3): entering a bar caps the roll tempo at
  927:     // that bar's earned rung — clean passes raised it, fumbles lowered it.
  928:     // The cap only pulls DOWN; the ramp back up stays the roll easing's job,
  929:     // so tempo rises only through demonstrated accuracy. The tempo lock
  930:     // always wins, and drills inherit whatever tempo the stream is at.
  931:     if (lock_tempo_ || !stream_active() || flow_.mode() != FlowController::TransportMode::Roll)
  932:         return;
  933:     int source_bar = -1;
  934:     if (const auto source = playhead_source())
  935:         source_bar = source->drill ? -1 : source->source_bar; // drills don't cap
  936:     else if (!stream_->composing() && quarters_per_bar_ > 0.0)
  937:         source_bar = static_cast<int>(stream_position_q() / quarters_per_bar_);
  938:     if (source_bar < 0 || source_bar == ladder_bar_)
  939:         return;
  940:     ladder_bar_ = source_bar;
  941:     // The cap is the MINIMUM rung across the PHRASE containing this bar, not
  942:     // the bar alone: a passage is played no faster than its hardest bar
  943:     // allows (the classic rule), so the pulse stays coherent across the
  944:     // phrase instead of lurching bar-to-bar over the mastery terrain. As
  945:     // every bar in the phrase improves, the phrase's floor rises — all
  946:     // ships. Unplayed bars hold the rung at the start fraction, so the
  947:     // stream never speeds into unread material. Without confident structure
  948:     // the bar's own rung applies (no phrase to be coherent across).
  949:     const PieceProfile& profile = session_->piece_profile();
  950:     double cap_frac = session_->model().bar_tempo_ladder(source_bar);
  951:     int cap_begin = source_bar;
  952:     int cap_end = source_bar + 1;
  953:     if (profile.structure_confidence >= StreamComposer::kMinStructureConfidence)
  954:     {
  955:         if (const PieceProfile::Phrase* phrase = profile.phrase_at_bar(source_bar))
  956:         {
  957:             cap_begin = phrase->start_bar;
  958:             cap_end = phrase->end_bar;
  959:             for (int bar = phrase->start_bar; bar < phrase->end_bar; ++bar)
  960:                 cap_frac = std::min(cap_frac, session_->model().bar_tempo_ladder(bar));
  961:         }
  962:     }
  963:     const double cap_qpm = flow_.marking_qpm() * cap_frac;
  964:     if (flow_.tempo_qpm() > cap_qpm)
  965:     {
  966:         flow_.set_tempo_qpm(cap_qpm);
  967:         DRAXUL_LOG_DEBUG(LogCategory::App,
  968:             "score: tempo ladder caps bars %d..%d at %.0f qpm (weakest rung %.2f)",
  969:             cap_begin + 1, cap_end, cap_qpm, cap_frac);
  970:     }

