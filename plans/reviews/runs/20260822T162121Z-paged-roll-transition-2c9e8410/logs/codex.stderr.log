  620: void ScoreRuntime::relayout_flow()
  621: {
  622:     flow_dirty_ = false;
  623:     if (!engine_ || !engine_->is_loaded())
  624:         return;
  625:     if (stream_->active())
  626:     {
  627:         // Leaving the windowed roll: the clock conveyor and paged view work
  628:         // on the whole piece again.
  629:         std::string reload_error;
  630:         if (!engine_->load(source_bytes_, reload_error))
  631:         {
  632:             DRAXUL_LOG_ERROR(LogCategory::App, "score: source reload failed: %s",
  633:                 reload_error.c_str());
  634:             return;
  635:         }
  636:         stream_->set_active(false);
  637:         stream_->clear_window_geometry();
  638:     }
  639: 
  640:     std::string error;
  641:     const FlowBuildResult result = build_flow_from_engine(error);
  642:     // A fresh engraving: re-fit the fixed score band's scale to the new
  643:     // content (the window high-water-mark restarts from the first window).
  644:     presentation_->invalidate_scale_lock();
  645:     if (result == FlowBuildResult::InterpretFailed)
  646:     {
  647:         DRAXUL_LOG_ERROR(
  648:             LogCategory::App, "score: flow interpret failed, staying paged: %s", error.c_str());
  649:         view_mode_ = ViewMode::Paged;
  650:         layout_dirty_ = true;
  651:         return;
  652:     }
  653:     const bool transport_ok = result == FlowBuildResult::Ok;
  654:     if (!transport_ok)
  655:         DRAXUL_LOG_ERROR(
  656:             LogCategory::App, "score: conveyor transport unavailable: %s", error.c_str());
  657: 
  658:     const double bar_quarters = quarters_per_measure_from_model();
  659:     quarters_per_bar_ = bar_quarters > 0.0 ? bar_quarters : 4.0;
  660:     piece_marking_qpm_ = flow_.marking_qpm();
  661:     session_->model().set_piece(has_model_ && !model_.title.empty()
  662:             ? model_.title
  663:             : std::filesystem::path(source_path_).filename().string(),
  664:         flow_.marking_qpm(), quarters_per_bar_);
  665:     apply_lit_update(); // anything at q <= 0 sits under the playhead pre-lit
  666:     DRAXUL_LOG_INFO(LogCategory::App, "score: conveyor strip %zu ops, %zu onsets, marking %d qpm",
  667:         strip_->glyphs.size() + strip_->paths.size() + strip_->texts.size(),
  668:         flow_.onsets().size(), static_cast<int>(std::lround(flow_.marking_qpm())));
  669: 
  670:     if (transport_ok)
  671:     {
  672:         // The rolling window needs the sliceable source; .mxl (zip) sources
  673:         // fall back to the monolithic strip (recorded follow-up).
  674:         if (stream_->windowed() && !stream_->slicer().ready())
  675:         {
  676:             std::string slicer_error;
  677:             if (!stream_->slicer().load(source_bytes_, slicer_error) || stream_->slicer().bar_count() < 2)
  678:             {
  679:                 stream_->set_windowed(false);
  680:                 DRAXUL_LOG_WARN(LogCategory::App,
  681:                     "score: rolling window unavailable, monolithic strip (%s)",
  682:                     slicer_error.c_str());
  683:             }
  684:         }
  685:         // Select the requested IComposer before configuring it (kanban 22
  686:         // seam); an unknown name keeps the adaptive-stream default.
  687:         if (!stream_->select_composer(composer_name_))
  688:             DRAXUL_LOG_WARN(LogCategory::App, "score: unknown composer '%s', using '%s'",
  689:                 composer_name_.c_str(), stream_->composer().name());
  690:         // Source compatibility is the composer's call (IComposer::supports):
  691:         // the adaptive stream needs a single-part source for its grand-staff
  692:         // drill bars; unsupported pieces stream the source verbatim.
  693:         stream_->set_composing(composer_enabled_ && stream_->windowed()
  694:             && stream_->composer().supports(stream_->slicer()));
  695:         if (stream_->composing())
  696:         {
  697:             stream_->composer().set_drills_enabled(composer_drills_);
  698:             stream_->composer().set_scales_enabled(composer_scales_);
  699:             stream_->composer().configure(&stream_->slicer(), &session_->model(), &session_->piece_profile());
  700:             reset_stream_plan();
  701:         }
  702: 
  703:         // Piece analysis (stream plan S1): key, chords + nearings, motifs,
  704:         // rhythm figures — from the judgment axis itself, dumped beside the
  705:         // progress file for inspection and cached for the composer. Built
  706:         // from the timemap so onsets carry DURATIONS (the sustain-aware
  707:         // skyline needs them to keep accompaniment out of the melody).
  708:         std::vector<AnalysisOnset> analysis_onsets;
  709:         {
  710:             std::string timemap_error;
  711:             const auto analysis_timemap = parse_timemap(engine_->render_timemap(), timemap_error);
  712:             if (analysis_timemap)
  713:                 analysis_onsets = analysis_onsets_from_timemap(*analysis_timemap,
  714:                     [this](const std::string& id) { return engine_->midi_pitch_for_element(id); });
  715:             else
  716:                 DRAXUL_LOG_DEBUG(LogCategory::App, "score: analysis timemap failed: %s",
  717:                     timemap_error.c_str());
  718:         }
  719:         std::optional<int> notated_fifths;
  720:         if (has_model_ && !model_.parts.empty())
  721:         {
  722:             for (const auto& measure : model_.parts[0].measures)
  723:             {
  724:                 if (measure.key)
  725:                 {
  726:                     notated_fifths = measure.key->fifths;
  727:                     break;
  728:                 }
  729:             }
  730:         }
  731:         session_->set_piece_profile(
  732:             analyze_piece(analysis_onsets, quarters_per_bar_, notated_fifths));
  733:         // A fresh analysis invalidates any overlay built against the old
  734:         // profile (the paged view may already be holding pages).
  735:         rebuild_analysis_overlay();
  736:         if (start_in_gate_)
  737:         {
  738:             start_in_gate_ = false;
  739:             enter_gate_mode(
  740:                 gate_input_requested_, kBotPaceQpm, gate_bot_accuracy_, midi_port_requested_);
  741:         }
  742:     }
  743: 
  744:     if (flow_autoplay_ && transport_ok)
  745:     {
  746:         flow_.play();
  747:         flow_autoplay_ = false;
  748:     }
  749:     scroll_y_ = std::clamp(scroll_y_, 0.0f, max_scroll());
  750:     if (callbacks_ != nullptr)
  751:         callbacks_->request_frame();
  752: }
